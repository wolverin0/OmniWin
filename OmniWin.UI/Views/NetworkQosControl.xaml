<UserControl x:Class="OmniWin.UI.Views.NetworkQosControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1000"
             Foreground="{DynamicResource TextPrimary}"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
             Loaded="UserControl_Loaded">

    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <!-- Sub-tab Switcher Header -->
            <RowDefinition Height="Auto" />
            <!-- Tab Content -->
            <RowDefinition Height="*" />
            <!-- Status Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header & Tabs Bar -->
        <Border Grid.Row="0" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Red Avanzada: QoS por Proceso, Conflictos de Puertos y Mantenimiento Idle" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="Limita el ancho de banda a apps que saturan tu conexión, diagnostica puertos bloqueados y automatiza el mantenimiento en inactividad." FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="RbTabQos" Content="🌐 Límite QoS" IsChecked="True" Style="{DynamicResource FilterRadioButton}" Checked="SubTab_Checked" Margin="0,0,6,0" />
                    <RadioButton x:Name="RbTabPorts" Content="🔍 Puertos &amp; Conflictos" Style="{DynamicResource FilterRadioButton}" Checked="SubTab_Checked" Margin="0,0,6,0" />
                    <RadioButton x:Name="RbTabIdle" Content="🤖 Robot Inactividad" Style="{DynamicResource FilterRadioButton}" Checked="SubTab_Checked" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- SUB-PAGE 1: LIMITADOR DE ANCHO DE BANDA QOS -->
        <Grid Grid.Row="1" x:Name="PageQos" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Configuration & Presets Card -->
            <Border Grid.Row="0" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="POLÍTICA DE CONTROL DE ANCHO DE BANDA (QOS)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="🎮 Preset Gaming (Steam/Discord a 300 KB/s)" Click="BtnGamingPreset_Click" Background="#2563EB" Foreground="White" Padding="12,5" FontSize="11.5" Margin="0,0,8,0" />
                            <Button Content="♾️ Quitar Todos los Límites" Click="BtnRemoveAllQos_Click" Style="{DynamicResource SecondaryButton}" Padding="12,5" FontSize="11.5" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtQosApp" Text="steam.exe" Background="#090D18" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorder}" Padding="8,6" FontSize="12" Margin="0,0,8,0" ToolTip="Nombre del ejecutable (ej. steam.exe, chrome.exe, qbittorrent.exe)" />
                        
                        <!-- Speed Slider -->
                        <Grid Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SliderQosRate" Minimum="100" Maximum="10000" Value="500" SmallChange="50" LargeChange="500" TickFrequency="500" VerticalAlignment="Center" ValueChanged="SliderQosRate_ValueChanged" />
                            <TextBlock Grid.Column="1" x:Name="TxtSliderValue" Text="500 KB/s" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="10,0,0,0" VerticalAlignment="Center" Width="75" />
                        </Grid>

                        <ComboBox Grid.Column="2" x:Name="CbQosPresets" SelectedIndex="1" SelectionChanged="CbQosPresets_SelectionChanged" Background="#090D18" Margin="0,0,8,0" VerticalAlignment="Center">
                            <ComboBoxItem Content="100 KB/s" Tag="100" />
                            <ComboBoxItem Content="500 KB/s" Tag="500" />
                            <ComboBoxItem Content="1.000 KB/s" Tag="1000" />
                            <ComboBoxItem Content="2.000 KB/s" Tag="2000" />
                            <ComboBoxItem Content="5.000 KB/s" Tag="5000" />
                        </ComboBox>

                        <Button Grid.Column="3" Content="⚡ Aplicar Límite" Click="BtnApplyQos_Click" Background="#059669" Foreground="White" Padding="14,6" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Active QoS Policies DataGrid -->
            <Border Grid.Row="1" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="POLÍTICAS QOS ACTIVAS EN EL SISTEMA OPERATIVO" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="🔄 Actualizar" Click="BtnRefreshQos_Click" Style="{DynamicResource SecondaryButton}" Padding="10,4" FontSize="11" />
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="DgQosPolicies" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0" GridLinesVisibility="None" HeadersVisibility="Column"
                              Foreground="{DynamicResource TextPrimary}" RowBackground="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre de Política" Binding="{Binding Name}" Width="200" />
                            <DataGridTextColumn Header="Ejecutable Limitado" Binding="{Binding AppPathName}" Width="*" />
                            <DataGridTextColumn Header="Límite (KB/s)" Binding="{Binding ThrottleRateKbpsText}" Width="130" />
                            <DataGridTextColumn Header="Límite (MB/s)" Binding="{Binding ThrottleRateMbpsText}" Width="130" />
                            <DataGridTemplateColumn Header="Acción" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Quitar" Click="BtnRemoveQosRow_Click" Tag="{Binding Name}" Style="{DynamicResource SecondaryButton}" Padding="10,3" FontSize="11" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- SUB-PAGE 2: PUERTOS Y RESOLUTOR DE CONFLICTOS -->
        <Grid Grid.Row="1" x:Name="PagePorts" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Search & Quick Port Diagnose Bar -->
            <Border Grid.Row="0" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Puerto a Consultar:" FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Grid.Column="1" x:Name="TxtPortSearch" Text="80" Background="#090D18" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorder}" Padding="8,5" FontSize="12" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="🔍 Diagnosticar" Click="BtnDiagnosePort_Click" Style="{DynamicResource SecondaryButton}" Margin="8,0,0,0" Padding="12,5" FontSize="12" VerticalAlignment="Center" />

                    <!-- Quick Status Output -->
                    <TextBlock Grid.Column="3" x:Name="TxtPortDiagnosisResult" Text="Ingresa un puerto (ej. 80, 443, 3000, 8080) o revisa la lista inferior." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="16,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                    <Button Grid.Column="4" x:Name="BtnReleasePort" Content="🔓 Liberar Puerto" Click="BtnReleasePort_Click" Background="#DC2626" Foreground="White" Padding="12,5" FontSize="12" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- Listening Ports DataGrid -->
            <Border Grid.Row="1" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="PUERTOS TCP EN ESCUCHA ACTIVA (LISTEN)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="🔄 Actualizar Puertos" Click="BtnRefreshPorts_Click" Style="{DynamicResource SecondaryButton}" Padding="10,4" FontSize="11" />
                    </Grid>

                    <DataGrid Grid.Row="1" x:Name="DgListeningPorts" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0" GridLinesVisibility="None" HeadersVisibility="Column"
                              Foreground="{DynamicResource TextPrimary}" RowBackground="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Puerto" Binding="{Binding Port}" Width="80" />
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="80" />
                            <DataGridTextColumn Header="Proceso" Binding="{Binding ProcessName}" Width="150" />
                            <DataGridTextColumn Header="Dirección Local" Binding="{Binding LocalAddress}" Width="140" />
                            <DataGridTextColumn Header="Servicio / Propósito" Binding="{Binding ServiceTag}" Width="*" />
                            <DataGridTemplateColumn Header="Acción" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Terminar &amp; Liberar" Click="BtnKillPortRow_Click" Tag="{Binding Port}" Background="#991B1B" Foreground="White" Padding="8,3" FontSize="11" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- SUB-PAGE 3: ROBOT DE MANTENIMIENTO EN INACTIVIDAD -->
        <Grid Grid.Row="1" x:Name="PageIdle" Visibility="Collapsed">
            <Border Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                        <TextBlock Text="Mantenimiento Autónomo en Inactividad" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                        <TextBlock Text="Ejecuta optimizaciones críticas del sistema de forma completamente silenciosa e imperceptible cuando no estés usando la computadora." FontSize="12.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16" />

                        <!-- Status Card -->
                        <Border Background="#090D18" CornerRadius="6" Padding="16" Margin="0,0,0,18" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtIdleMonitoringStatus" Text="Estado: Monitor ACTIVO ✔" FontSize="14" FontWeight="Bold" Foreground="#34D399" />
                                    <TextBlock x:Name="TxtIdleTimerInfo" Text="Inactividad actual: 0 seg • Umbral: 600 seg (10 min)" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" />
                                    <TextBlock x:Name="TxtIdleLastRun" Text="Última ejecución: Sin registros." FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnToggleIdleMonitor" Content="Detener Monitor" Click="BtnToggleIdleMonitor_Click" Style="{DynamicResource SecondaryButton}" Padding="12,6" FontSize="12" Margin="0,0,8,0" />
                                    <Button Content="⚡ Ejecutar Ahora" Click="BtnRunIdleNow_Click" Background="#2563EB" Foreground="White" Padding="14,6" FontSize="12" FontWeight="Bold" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="TAREAS AUTOMÁTICAS INCLUIDAS" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" />

                        <!-- Checkboxes for Tasks -->
                        <CheckBox x:Name="ChkTrimSsd" Content="Re-Trim de SSDs y NVMe (Optimize-Volume -ReTrim)" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" FontSize="12" />
                        <CheckBox x:Name="ChkPurgeRam" Content="Purga de Standby List en RAM si el consumo del sistema supera el 80%" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" FontSize="12" />
                        <CheckBox x:Name="ChkCleanTemp" Content="Limpieza segura de archivos temporales obsoletos (> 24 horas de antigüedad)" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16" FontSize="12" />

                        <TextBlock Text="LOG DE ÚLTIMO MANTENIMIENTO" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                        <TextBox x:Name="TxtIdleLog" Text="Sin registros recientes." Height="130" IsReadOnly="True" Background="#050811" Foreground="#34D399" FontFamily="Consolas" FontSize="11.5" Padding="10" BorderThickness="1" BorderBrush="{DynamicResource CardBorder}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Footer -->
        <TextBlock Grid.Row="2" x:Name="TxtStatus" Text="Listo." FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="2,8,0,0" />
    </Grid>
</UserControl>
