<UserControl x:Class="OmniWin.UI.Views.WelcomeTourControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
             Foreground="{StaticResource TextPrimary}">

    <Border Background="#0B0F19" BorderBrush="#1C273C" BorderThickness="1" CornerRadius="14" MaxWidth="820" MaxHeight="590" Padding="26">
        <Border.Effect>
            <DropShadowEffect BlurRadius="52" Color="#000000" Opacity="0.88" ShadowDepth="14" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: Header with Progress Indicator & Close -->
                <RowDefinition Height="Auto" />
                <!-- 1: Slide Content -->
                <RowDefinition Height="*" />
                <!-- 2: Navigation Footer Controls -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 0. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0C243C" BorderBrush="#16395F" BorderThickness="1" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Accent}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="OmniWin PRO" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                            <Border Background="#101B2E" BorderBrush="#1A2D4C" BorderThickness="1" CornerRadius="4" Margin="10,2,0,2" Padding="7,2">
                                <TextBlock x:Name="TxtTourSlideBadge" Text="1 de 3 • Bienvenida" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Tour rápido de introducción y mapa de herramientas de Windows Control Plane." FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Content="✕" Click="BtnClose_Click" Background="Transparent" Foreground="{StaticResource TextMuted}" FontSize="15" Width="30" Height="30" Padding="0" Cursor="Hand" ToolTip="Cerrar Tour" />
            </Grid>

            <!-- 1. Slides Body -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <!-- SLIDE 1: INTRODUCCIÓN & PRINCIPIOS -->
                <StackPanel x:Name="Slide1" Visibility="Visible">
                    <TextBlock Text="Control Total de Windows, Sin Trucos Ni Riesgos" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6" />
                    <TextBlock Text="OmniWin reúne 29 utilidades de nivel profesional bajo una filosofía estricta de estabilidad de kernel y cero bloatware." FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,16" TextWrapping="Wrap" />

                    <Grid Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Card 1 -->
                        <Border Grid.Row="0" Background="#0E1524" BorderBrush="#1A2740" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" Background="#0C2E20" BorderBrush="#124E37" BorderThickness="1" CornerRadius="8" Margin="0,0,14,0">
                                    <TextBlock Text="🛡️" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Safe-by-Design &amp; Reversible con WAL" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="Sin hacks destructivos. Modificaciones transaccionales respaldadas en Write-Ahead Logging con restauración en 1 clic." FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 2 -->
                        <Border Grid.Row="1" Background="#0E1524" BorderBrush="#1A2740" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" Background="#0B2544" BorderBrush="#143B6B" BorderThickness="1" CornerRadius="8" Margin="0,0,14,0">
                                    <TextBlock Text="⚡" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Accent}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Rendimiento Nativo &amp; Baja Latencia" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="Llamadas nativas Win32/NT, purga de Standby List, micro-timer de resolución 0.5ms y afinidad a P-Cores para gaming." FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 3 -->
                        <Border Grid.Row="2" Background="#0E1524" BorderBrush="#1A2740" BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" Background="#28153A" BorderBrush="#432263" BorderThickness="1" CornerRadius="8" Margin="0,0,14,0">
                                    <TextBlock Text="🤖" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Servidor de Agentes IA (MCP Server 49 Tools)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="Integración nativa con Antigravity, Claude Desktop y Cursor para auditar y operar tu PC mediante comandos de lenguaje natural." FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- SLIDE 2: LOS 6 CENTROS DE CONTROL -->
                <StackPanel x:Name="Slide2" Visibility="Collapsed">
                    <TextBlock Text="Arquitectura en 6 Centros de Control (Hubs)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" />
                    <TextBlock Text="Las 29 herramientas están ahora organizadas temáticamente para que encuentres exactamente lo que necesitas en 1 clic:" FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14" TextWrapping="Wrap" />

                    <UniformGrid Columns="2" Rows="3" Margin="0,0,0,4">
                        <!-- Hub 0 -->
                        <Border Background="#0E1524" BorderBrush="#1A2740" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="3">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="📊 0. Visión General" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Accent}" />
                                    <TextBlock Text="(4 herram.)" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="6,1,0,0" />
                                </StackPanel>
                                <TextBlock Text="Dashboard en vivo, telemetría Prometheus, forense de procesos y servidor móvil OmniCompanion." FontSize="10.8" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Hub 1 -->
                        <Border Background="#0E1524" BorderBrush="#1A2740" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="3">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="⚡ 1. Rendimiento &amp; Gaming" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" />
                                    <TextBlock Text="(4 herram.)" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="6,1,0,0" />
                                </StackPanel>
                                <TextBlock Text="Purga de RAM Standby List, profiler automático de juegos, afinidad CPU y mezclador CoreAudio." FontSize="10.8" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Hub 2 -->
                        <Border Background="#0E1524" BorderBrush="#1A2740" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="3">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="💾 2. Almacenamiento" FontWeight="Bold" FontSize="12" Foreground="#FBBF24" />
                                    <TextBlock Text="(7 herram.)" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="6,1,0,0" />
                                </StackPanel>
                                <TextBlock Text="Mapa WizTree, deduplicador Zero-Copy, migrador de juegos Junctions, limpiador, USB Doctor y undelete." FontSize="10.8" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Hub 3 -->
                        <Border Background="#0E1524" BorderBrush="#1A2740" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="3">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="🌐 3. Red &amp; Conectividad" FontWeight="Bold" FontSize="12" Foreground="#34D399" />
                                    <TextBlock Text="(4 herram.)" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="6,1,0,0" />
                                </StackPanel>
                                <TextBlock Text="Diagnóstico sockets, cortafuegos visual, DNS Seguro DoH, bloqueo HOSTS y limitador QoS por app." FontSize="10.8" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Hub 4 -->
                        <Border Background="#0E1524" BorderBrush="#1A2740" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="3">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="🛡️ 4. Seguridad &amp; Privacidad" FontWeight="Bold" FontSize="12" Foreground="#A78BFA" />
                                    <TextBlock Text="(3 herram.)" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="6,1,0,0" />
                                </StackPanel>
                                <TextBlock Text="Blindaje anti-telemetría WAL, 16 reglas Microsoft Defender ASR y forense de BSOD/caja negra." FontSize="10.8" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- Hub 5 -->
                        <Border Background="#0E1524" BorderBrush="#1A2740" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="3">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="⚙️ 5. Sistema &amp; Herramientas" FontWeight="Bold" FontSize="12" Foreground="#F472B6" />
                                    <TextBlock Text="(7 herram.)" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="6,1,0,0" />
                                </StackPanel>
                                <TextBlock Text="55+ Tweaks &amp; Debloat, WinGet, reparación DISM/SFC, inicio de Windows, fondos 4K y MCP." FontSize="10.8" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <!-- SLIDE 3: ATAJOS Y CONTINUACIÓN -->
                <StackPanel x:Name="Slide3" Visibility="Collapsed">
                    <TextBlock Text="Atajos de Teclado Globales &amp; Automatización" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6" />
                    <TextBlock Text="OmniWin funciona en segundo plano sin ralentizar tu PC. Usa estos atajos en cualquier momento, incluso dentro de juegos:" FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,16" TextWrapping="Wrap" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Hotkey 1 -->
                        <Border Grid.Column="0" Background="#0E1524" BorderBrush="#1A2740" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,6,0">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Background="#12253B" BorderBrush="#1A3B61" BorderThickness="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock Text="Ctrl + Shift + P" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource Accent}" />
                                </Border>
                                <TextBlock Text="Purga Relámpago RAM" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2" />
                                <TextBlock Text="Libera Standby List al instante sin abrir la ventana." FontSize="10.8" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Hotkey 2 -->
                        <Border Grid.Column="1" Background="#0E1524" BorderBrush="#1A2740" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="3,0,3,0">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Background="#12253B" BorderBrush="#1A3B61" BorderThickness="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock Text="Ctrl + Shift + O" FontWeight="Bold" FontSize="12.5" Foreground="#38BDF8" />
                                </Border>
                                <TextBlock Text="Overlay HUD de Juego" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2" />
                                <TextBlock Text="Muestra FPS, CPU/GPU % y temperaturas sobre tus juegos." FontSize="10.8" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Hotkey 3 -->
                        <Border Grid.Column="2" Background="#0E1524" BorderBrush="#1A2740" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="6,0,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Background="#12253B" BorderBrush="#1A3B61" BorderThickness="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock Text="Ctrl + Shift + W" FontWeight="Bold" FontSize="12.5" Foreground="#34D399" />
                                </Border>
                                <TextBlock Text="Widget de Escritorio" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2" />
                                <TextBlock Text="Panel flotante transparente con tráfico de red y RAM." FontSize="10.8" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="#091A2A" BorderBrush="#123B61" BorderThickness="1" CornerRadius="8" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="💡" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1" Text="¿Listo para comenzar? Puedes iniciar el Asistente Guiado para optimizar tu equipo en 7 pasos según tu hardware, o saltar directamente al Dashboard principal." FontSize="11.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 2. Navigation Footer -->
            <Grid Grid.Row="2" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Step dots -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="Dot1" Width="20" Height="6" CornerRadius="3" Background="{StaticResource Accent}" Margin="0,0,4,0" />
                    <Border x:Name="Dot2" Width="8" Height="6" CornerRadius="3" Background="#1C273C" Margin="0,0,4,0" />
                    <Border x:Name="Dot3" Width="8" Height="6" CornerRadius="3" Background="#1C273C" />
                </StackPanel>

                <!-- Navigation buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnPrev" Content="◀ Anterior" Click="BtnPrev_Click" Style="{StaticResource SecondaryButton}" Padding="14,6" FontSize="11.5" Margin="0,0,8,0" Visibility="Collapsed" />
                    <Button x:Name="BtnNext" Content="Siguiente ▶" Click="BtnNext_Click" Padding="16,6" FontSize="11.5" />
                    
                    <!-- Final slide actions -->
                    <Button x:Name="BtnStartWizard" Content="🚀 Iniciar Asistente de Optimización" Click="BtnStartWizard_Click" Padding="16,6" FontSize="11.5" Margin="0,0,8,0" Visibility="Collapsed" />
                    <Button x:Name="BtnGoDashboard" Content="📊 Ir al Dashboard" Click="BtnGoDashboard_Click" Style="{StaticResource SecondaryButton}" Padding="14,6" FontSize="11.5" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
