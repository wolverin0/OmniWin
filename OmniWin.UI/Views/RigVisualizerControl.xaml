<UserControl x:Class="OmniWin.UI.Views.RigVisualizerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1050"
             Foreground="{DynamicResource TextPrimary}"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
             Loaded="UserControl_Loaded">

    <Grid Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <!-- Top Controls Header -->
            <RowDefinition Height="Auto" />
            <!-- Main Content: Chassis Hologram / AI Render + Inspector / OpenRGB -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header Card -->
        <Border Grid.Row="0" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="#1E1B4B" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                            <TextBlock x:Name="TxtRigSummaryBadge" Text="HARDWARE DETECTADO" FontSize="11" FontWeight="Bold" Foreground="#818CF8" />
                        </Border>
                        <TextBlock Text="Visualizador Holográfico de PC &amp; Sincronización OpenRGB" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                    </StackPanel>
                    <TextBlock Text="Esquema interactivo en tiempo real de tu máquina y controlador universal de iluminación RGB sin bloatware de fabricantes." FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>

                <!-- View Switcher -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnModeRealisticRig" Content="🖥️ Gabinete Gaming (RGB Live)" Click="BtnModeAiRender_Click" Style="{DynamicResource PrimaryButton}" Padding="12,6" FontSize="11.5" Margin="0,0,6,0" Cursor="Hand" />
                    <Button x:Name="BtnModeHologram" Content="📐 Blueprint Holográfico" Click="BtnModeHologram_Click" Background="#1E293B" Foreground="{DynamicResource TextPrimary}" BorderBrush="#334155" BorderThickness="1" Padding="12,6" FontSize="11.5" Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Visualizer Viewport -->
                <ColumnDefinition Width="6*" />
                <!-- Sidebar: Component Diagnostics + OpenRGB -->
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Chassis Blueprint / AI Render -->
            <Border Grid.Column="0" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                <Grid>
                    <!-- Mode A: Interactive Holographic Blueprint -->
                    <Border x:Name="PnlHologramView" Visibility="Collapsed" Background="#060911" BorderBrush="#162035" BorderThickness="1" CornerRadius="8" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Case Header / Exhaust Fans -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <TextBlock Text="CHASIS GAMER PANORÁMICO" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text=" • FLUJO DE AIRE ACTIVO" FontSize="10.5" Foreground="#10B981" Margin="6,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <!-- Top 360mm Radiator Fans -->
                                    <Border x:Name="FanTop1" Width="36" Height="14" Background="#0F172A" BorderBrush="{Binding CurrentRgbBrush}" BorderThickness="1.5" CornerRadius="3" Margin="0,0,4,0" ToolTip="Ventilador Superior 1" />
                                    <Border x:Name="FanTop2" Width="36" Height="14" Background="#0F172A" BorderBrush="{Binding CurrentRgbBrush}" BorderThickness="1.5" CornerRadius="3" Margin="0,0,4,0" ToolTip="Ventilador Superior 2" />
                                    <Border x:Name="FanTop3" Width="36" Height="14" Background="#0F172A" BorderBrush="{Binding CurrentRgbBrush}" BorderThickness="1.5" CornerRadius="3" ToolTip="Ventilador Superior 3" />
                                </StackPanel>
                            </Grid>

                            <!-- Motherboard Tray & Core Components -->
                            <Border Grid.Row="1" Background="#0B0F19" BorderBrush="#1E293B" BorderThickness="1.5" CornerRadius="6" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Motherboard Name Header -->
                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" x:Name="TxtMbHeader" Text="Gigabyte Technology Co., Ltd. Z790 AORUS PRO X" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,12" Cursor="Hand" MouseLeftButtonUp="Component_Click" Tag="MOTHERBOARD" />

                                    <!-- CPU & AIO Cooler Area -->
                                    <Border Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="190" Height="145" Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,14,10" Cursor="Hand" MouseLeftButtonUp="Component_Click" Tag="CPU">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Top">
                                                <TextBlock Text="SOCKET CPU" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" />
                                                <TextBlock x:Name="TxtCpuName" Text="Intel Core i9-14900K" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <!-- AIO Circular Pump with Live Temp & RGB Ring -->
                                            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="78" Height="78" CornerRadius="39" Background="#030712" BorderBrush="{Binding CurrentRgbBrush}" BorderThickness="3">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock x:Name="TxtCpuTempCircle" Text="48°C" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="TxtCpuClockCircle" Text="5.8 GHz" FontSize="9.5" Foreground="#38BDF8" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- 4x RAM DDR5 Slots -->
                                    <Border Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="6" Padding="10" Cursor="Hand" MouseLeftButtonUp="Component_Click" Tag="RAM">
                                        <StackPanel>
                                            <TextBlock Text="BANCO DE MEMORIA DDR5" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4" />
                                            <TextBlock x:Name="TxtRamTotal" Text="64 GB (4 Módulos)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="RamStick1" Width="10" Height="68" Background="{Binding CurrentRgbBrush}" CornerRadius="2" Margin="0,0,4,0" ToolTip="Ranura DIMM 1" />
                                                <Border x:Name="RamStick2" Width="10" Height="68" Background="{Binding CurrentRgbBrush}" CornerRadius="2" Margin="0,0,4,0" ToolTip="Ranura DIMM 2" />
                                                <Border x:Name="RamStick3" Width="10" Height="68" Background="{Binding CurrentRgbBrush}" CornerRadius="2" Margin="0,0,4,0" ToolTip="Ranura DIMM 3" />
                                                <Border x:Name="RamStick4" Width="10" Height="68" Background="{Binding CurrentRgbBrush}" CornerRadius="2" ToolTip="Ranura DIMM 4" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- GPU PCIe Slot & Card Area -->
                                    <Border Grid.Row="2" Grid.ColumnSpan="2" Height="78" Background="#111827" BorderBrush="{Binding CurrentRgbBrush}" BorderThickness="1.5" CornerRadius="6" Padding="12,8" Margin="0,10,0,0" Cursor="Hand" MouseLeftButtonUp="Component_Click" Tag="GPU">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="TARJETA GRÁFICA PCIe Gen 4" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" />
                                                    <TextBlock x:Name="TxtGpuTemp" Text="42°C" FontSize="10.5" FontWeight="Bold" Foreground="#10B981" Margin="8,0,0,0" />
                                                </StackPanel>
                                                <TextBlock x:Name="TxtGpuName" Text="NVIDIA GeForce RTX 3080" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                                <TextBlock x:Name="TxtGpuVram" Text="10 GB GDDR6X • Bus 320-bit" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" />
                                            </StackPanel>
                                            <!-- GPU Fans Indicator -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource CardDarkHover}" BorderBrush="#334155" BorderThickness="1.5" Margin="0,0,6,0">
                                                    <TextBlock Text="❄️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource CardDarkHover}" BorderBrush="#334155" BorderThickness="1.5">
                                                    <TextBlock Text="❄️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Bottom Intake & Storage Shroud -->
                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Border Background="#1E293B" CornerRadius="4" Padding="8,4" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="Component_Click" Tag="STORAGE">
                                        <TextBlock x:Name="TxtStorageBadge" Text="💾 4 Unidades Almacenamiento" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="RGB SINCRONIZADO:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <Border Width="16" Height="16" CornerRadius="8" Background="{Binding CurrentRgbBrush}" BorderBrush="White" BorderThickness="1" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Mode B: Photorealistic Interactive 3D Gaming Rig with Live ARGB Layers -->
                    <Border x:Name="PnlInteractiveRigView" Visibility="Visible" Background="#030712" CornerRadius="8" ClipToBounds="True" BorderBrush="#162035" BorderThickness="1">
                        <Grid>
                            <!-- 3D Transform Interactive Container (Zoom, Pan, Rotate, Perspectives) -->
                            <Grid x:Name="RigInteractiveContainer" RenderTransformOrigin="0.5,0.5"
                                  MouseWheel="RigContainer_MouseWheel"
                                  MouseLeftButtonDown="RigContainer_MouseLeftButtonDown"
                                  MouseLeftButtonUp="RigContainer_MouseLeftButtonUp"
                                  MouseMove="RigContainer_MouseMove">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="RigScaleTransform" ScaleX="1.0" ScaleY="1.0" />
                                        <RotateTransform x:Name="RigRotateTransform" Angle="0" />
                                        <SkewTransform x:Name="RigSkewTransform" AngleX="0" AngleY="0" />
                                        <TranslateTransform x:Name="RigTranslateTransform" X="0" Y="0" />
                                    </TransformGroup>
                                </Grid.RenderTransform>

                                <!-- Underlying Photorealistic Chassis Render -->
                                <Image x:Name="ImgInteractiveRig" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                <!-- Interactive ARGB Lighting & Component Overlay (Aligned to 1000x562 16:9 Canvas) -->
                                <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="1000" Height="562">
                                        <!-- 1. AIO Liquid Cooler Pump Block (Live Temp OLED & Glowing RGB Ring) -->
                                        <Border Canvas.Left="405" Canvas.Top="222" Width="84" Height="84" CornerRadius="42"
                                                BorderThickness="3" BorderBrush="{Binding CurrentRgbBrush}"
                                                Cursor="Hand" MouseLeftButtonUp="Component_Click" Tag="CPU">
                                            <Border.ToolTip>
                                                <ToolTip Content="Bomba Líquida AIO — Intel Core i9-14900K (Clic para diagnóstico)" />
                                            </Border.ToolTip>
                                            <Border.Effect>
                                                <DropShadowEffect Color="{Binding CurrentRgbColor}" BlurRadius="24" ShadowDepth="0" Opacity="0.95" />
                                            </Border.Effect>
                                            <Grid>
                                                <Border Width="68" Height="68" CornerRadius="34" Background="#D5020617">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock x:Name="TxtLiveCpuTempOnPump" Text="{Binding LiveCpuTempString}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                                        <TextBlock Text="i9-14900K" FontSize="8.5" FontWeight="SemiBold" Foreground="#38BDF8" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- 2. DDR5 RGB Memory Banks (4 Modules with Dynamic Lightbars) -->
                                        <Border Canvas.Left="486" Canvas.Top="166" Width="38" Height="126"
                                                Cursor="Hand" MouseLeftButtonUp="Component_Click" Tag="RAM" Background="#11000000">
                                            <Border.ToolTip>
                                                <ToolTip Content="64 GB DDR5 RAM Banks (4 Módulos ARGB Sincronizados — Clic para detalles)" />
                                            </Border.ToolTip>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Rectangle Width="5.5" Height="118" Margin="1.5,0" RadiusX="2" RadiusY="2" Fill="{Binding CurrentRgbBrush}">
                                                    <Rectangle.Effect><DropShadowEffect Color="{Binding CurrentRgbColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.9" /></Rectangle.Effect>
                                                </Rectangle>
                                                <Rectangle Width="5.5" Height="118" Margin="1.5,0" RadiusX="2" RadiusY="2" Fill="{Binding CurrentRgbBrush}">
                                                    <Rectangle.Effect><DropShadowEffect Color="{Binding CurrentRgbColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.9" /></Rectangle.Effect>
                                                </Rectangle>
                                                <Rectangle Width="5.5" Height="118" Margin="1.5,0" RadiusX="2" RadiusY="2" Fill="{Binding CurrentRgbBrush}">
                                                    <Rectangle.Effect><DropShadowEffect Color="{Binding CurrentRgbColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.9" /></Rectangle.Effect>
                                                </Rectangle>
                                                <Rectangle Width="5.5" Height="118" Margin="1.5,0" RadiusX="2" RadiusY="2" Fill="{Binding CurrentRgbBrush}">
                                                    <Rectangle.Effect><DropShadowEffect Color="{Binding CurrentRgbColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.9" /></Rectangle.Effect>
                                                </Rectangle>
                                            </StackPanel>
                                        </Border>

                                        <!-- 3. NVIDIA GeForce RTX 3080 (Lightbar & Temp Badge) -->
                                        <Border Canvas.Left="285" Canvas.Top="310" Width="310" Height="52"
                                                Cursor="Hand" MouseLeftButtonUp="Component_Click" Tag="GPU" Background="#08000000">
                                            <Border.ToolTip>
                                                <ToolTip Content="NVIDIA GeForce RTX 3080 (Ampere 10GB GDDR6X — Clic para diagnóstico)" />
                                            </Border.ToolTip>
                                            <Grid>
                                                <!-- Top Edge Glowing Lightstrip -->
                                                <Rectangle VerticalAlignment="Top" Height="3.5" RadiusX="1.5" RadiusY="1.5" Fill="{Binding CurrentRgbBrush}">
                                                    <Rectangle.Effect><DropShadowEffect Color="{Binding CurrentRgbColor}" BlurRadius="20" ShadowDepth="0" Opacity="0.95" /></Rectangle.Effect>
                                                </Rectangle>
                                                <!-- GeForce RTX Logo Badge -->
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" CornerRadius="3" Background="#CC030712" BorderBrush="{Binding CurrentRgbBrush}" BorderThickness="1" Padding="6,2">
                                                    <TextBlock Text="GEFORCE RTX" FontSize="8.5" FontWeight="Bold" Foreground="{Binding CurrentRgbBrush}" />
                                                </Border>
                                                <!-- GPU Live Temp Badge -->
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0" CornerRadius="3" Background="#CC030712" BorderBrush="#1E293B" BorderThickness="1" Padding="6,2">
                                                    <TextBlock Text="{Binding LiveGpuTempString}" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- 4. Front & Side Intake ARGB Fans (3x Rings) -->
                                        <Border Canvas.Left="645" Canvas.Top="156" Width="74" Height="74" CornerRadius="37" BorderThickness="2.5" BorderBrush="{Binding CurrentRgbBrush}" Cursor="Hand" MouseLeftButtonUp="Component_Click" Tag="FANS">
                                            <Border.Effect><DropShadowEffect Color="{Binding CurrentRgbColor}" BlurRadius="26" ShadowDepth="0" Opacity="0.85" /></Border.Effect>
                                        </Border>
                                        <Border Canvas.Left="645" Canvas.Top="256" Width="74" Height="74" CornerRadius="37" BorderThickness="2.5" BorderBrush="{Binding CurrentRgbBrush}" Cursor="Hand" MouseLeftButtonUp="Component_Click" Tag="FANS">
                                            <Border.Effect><DropShadowEffect Color="{Binding CurrentRgbColor}" BlurRadius="26" ShadowDepth="0" Opacity="0.85" /></Border.Effect>
                                        </Border>
                                        <Border Canvas.Left="645" Canvas.Top="356" Width="74" Height="74" CornerRadius="37" BorderThickness="2.5" BorderBrush="{Binding CurrentRgbBrush}" Cursor="Hand" MouseLeftButtonUp="Component_Click" Tag="FANS">
                                            <Border.Effect><DropShadowEffect Color="{Binding CurrentRgbColor}" BlurRadius="26" ShadowDepth="0" Opacity="0.85" /></Border.Effect>
                                        </Border>

                                        <!-- 5. Rear & Top Radiator ARGB Fans -->
                                        <Border Canvas.Left="272" Canvas.Top="156" Width="20" Height="80" CornerRadius="3" Background="{Binding CurrentRgbBrush}" Cursor="Hand" MouseLeftButtonUp="Component_Click" Tag="FANS">
                                            <Border.Effect><DropShadowEffect Color="{Binding CurrentRgbColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.85" /></Border.Effect>
                                        </Border>
                                        <StackPanel Canvas.Left="325" Canvas.Top="106" Orientation="Horizontal" Cursor="Hand" MouseLeftButtonUp="Component_Click" Tag="FANS">
                                            <Border Width="108" Height="14" CornerRadius="3" Background="{Binding CurrentRgbBrush}" Margin="0,0,10,0"><Border.Effect><DropShadowEffect Color="{Binding CurrentRgbColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.8" /></Border.Effect></Border>
                                            <Border Width="108" Height="14" CornerRadius="3" Background="{Binding CurrentRgbBrush}" Margin="0,0,10,0"><Border.Effect><DropShadowEffect Color="{Binding CurrentRgbColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.8" /></Border.Effect></Border>
                                            <Border Width="108" Height="14" CornerRadius="3" Background="{Binding CurrentRgbBrush}"><Border.Effect><DropShadowEffect Color="{Binding CurrentRgbColor}" BlurRadius="15" ShadowDepth="0" Opacity="0.8" /></Border.Effect></Border>
                                        </StackPanel>

                                        <!-- 6. Motherboard Z790 AORUS Shield Zone -->
                                        <Border Canvas.Left="298" Canvas.Top="165" Width="74" Height="76" CornerRadius="4" Cursor="Hand" MouseLeftButtonUp="Component_Click" Tag="MOTHERBOARD" Background="#01000000">
                                            <Border.ToolTip><ToolTip Content="Gigabyte Z790 AORUS PRO X (Clic para diagnóstico)" /></Border.ToolTip>
                                        </Border>
                                    </Canvas>
                                </Viewbox>
                            </Grid>

                            <!-- Floating 3D Perspective Selector Toolbar -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Background="#DD0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="4">
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BtnPerspectiveIsometric" Content="🧭 Isométrica" Click="BtnPerspective_Click" Tag="Isometric" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" Padding="8,4" FontSize="10" Margin="0,0,4,0" Cursor="Hand" />
                                    <Button x:Name="BtnPerspectiveFront" Content="📐 Frontal" Click="BtnPerspective_Click" Tag="Front" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" Padding="8,4" FontSize="10" Margin="0,0,4,0" Cursor="Hand" />
                                    <Button x:Name="BtnPerspectiveExploded" Content="🔍 Zoom Detalle" Click="BtnPerspective_Click" Tag="Zoom" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" Padding="8,4" FontSize="10" Margin="0,0,4,0" Cursor="Hand" />
                                    <Button x:Name="BtnPerspectiveReset" Content="↺ Reset" Click="BtnPerspective_Click" Tag="Reset" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" Padding="6,4" FontSize="10" Cursor="Hand" />
                                </StackPanel>
                            </Border>

                            <!-- Bottom Glass Overlay Guide -->
                            <Border VerticalAlignment="Bottom" Background="#DD090D18" Padding="14,8" BorderBrush="#162035" BorderThickness="0,1,0,0">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="✨ GABINETE INTERACTIVO EN VIVO" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,10,0" />
                                        <TextBlock Text="Capas ARGB dinámicas sincronizadas • Rueda del ratón para Zoom • Arrastrar para rotar/mover" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border Width="12" Height="12" CornerRadius="6" Background="{Binding CurrentRgbBrush}" Margin="0,0,6,0" />
                                        <TextBlock Text="ARGB ACTIVO" FontSize="10" FontWeight="Bold" Foreground="{Binding CurrentRgbBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT: Component Diagnostics & OpenRGB Hub -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Component Inspector Card -->
                <Border Grid.Row="0" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="DIAGNÓSTICO DEL COMPONENTE" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8" />
                        <TextBlock x:Name="TxtInspectorTitle" Text="Intel Core i9-14900K" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                        <TextBlock x:Name="TxtInspectorSubtitle" Text="24 Núcleos (8 Rendimiento + 16 Eficiencia) • 32 Hilos" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" />

                        <Border Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10">
                            <StackPanel x:Name="PnlInspectorDetails">
                                <TextBlock Text="• Reloj Actual: 5.7 - 5.8 GHz (Turbo Boost)" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" Margin="0,1" />
                                <TextBlock Text="• Temperatura de Paquete: 48°C (Rango Seguro)" FontSize="11.5" Foreground="#10B981" Margin="0,1" />
                                <TextBlock Text="• Litografía / Arquitectura: Intel 7 (Raptor Lake Refresh)" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,1" />
                                <TextBlock Text="• TDP / Potencia Base: 125W (253W Max Turbo)" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,1" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Universal OpenRGB Control Card -->
                <Border Grid.Row="1" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="SINCRONIZACIÓN UNIVERSAL RGB" FontSize="11" FontWeight="Bold" Foreground="#818CF8" VerticalAlignment="Center" />
                                <Button Grid.Column="1" x:Name="BtnReconnectOpenRgb" Content="🔄 Conectar" Click="BtnReconnectOpenRgb_Click" Background="#1E293B" Foreground="#38BDF8" BorderThickness="0" Padding="8,2" FontSize="10.5" Cursor="Hand" />
                            </Grid>

                            <!-- OpenRGB Connection Status Badge -->
                            <Border x:Name="BrdOpenRgbStatus" Background="#064E3B" CornerRadius="4" Padding="8,4" Margin="0,0,0,10">
                                <TextBlock x:Name="TxtOpenRgbStatus" Text="🟢 Modo Simulación Activo (4 Dispositivos Listos)" FontSize="11" FontWeight="Bold" Foreground="#34D399" />
                            </Border>

                            <TextBlock Text="Paletas de Color Rápidas:" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                            <WrapPanel Margin="0,0,0,12">
                                <Button Content="🧊 Cian Ártico" Tag="#00E5FF" Click="BtnPresetColor_Click" Background="#0F172A" Foreground="#00E5FF" BorderBrush="#1E293B" BorderThickness="1" Padding="8,4" FontSize="10.5" Margin="0,0,4,4" Cursor="Hand" />
                                <Button Content="🟢 Esmeralda" Tag="#10B981" Click="BtnPresetColor_Click" Background="#0F172A" Foreground="#10B981" BorderBrush="#1E293B" BorderThickness="1" Padding="8,4" FontSize="10.5" Margin="0,0,4,4" Cursor="Hand" />
                                <Button Content="🟣 Cyberpunk" Tag="#A855F7" Click="BtnPresetColor_Click" Background="#0F172A" Foreground="#A855F7" BorderBrush="#1E293B" BorderThickness="1" Padding="8,4" FontSize="10.5" Margin="0,0,4,4" Cursor="Hand" />
                                <Button Content="🔴 Sangre" Tag="#EF4444" Click="BtnPresetColor_Click" Background="#0F172A" Foreground="#EF4444" BorderBrush="#1E293B" BorderThickness="1" Padding="8,4" FontSize="10.5" Margin="0,0,4,4" Cursor="Hand" />
                                <Button Content="🟡 Fuego" Tag="#F59E0B" Click="BtnPresetColor_Click" Background="#0F172A" Foreground="#F59E0B" BorderBrush="#1E293B" BorderThickness="1" Padding="8,4" FontSize="10.5" Margin="0,0,4,4" Cursor="Hand" />
                                <Button Content="⚪ Blanco Puro" Tag="#FFFFFF" Click="BtnPresetColor_Click" Background="#0F172A" Foreground="#F8FAFC" BorderBrush="#1E293B" BorderThickness="1" Padding="8,4" FontSize="10.5" Margin="0,0,4,4" Cursor="Hand" />
                            </WrapPanel>

                            <!-- Dynamic Reactive Modes -->
                            <TextBlock Text="Modos Inteligentes:" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                            <Border Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <CheckBox x:Name="ChkThermalRgb" Content="🌡️ Reactivo a Temperatura CPU (Azul -> Verde -> Rojo)" Checked="ChkThermalRgb_Changed" Unchecked="ChkThermalRgb_Changed" Foreground="{DynamicResource TextPrimary}" FontSize="11" Margin="0,0,0,8" />
                                    <CheckBox x:Name="ChkGameAtmosphere" Content="🎮 Game Profile Sync (Cambio de luces al abrir juego)" IsChecked="True" Foreground="{DynamicResource TextPrimary}" FontSize="11" />
                                </StackPanel>
                            </Border>

                            <!-- Target Devices List -->
                            <TextBlock Text="Dispositivos Sincronizados:" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                            <ItemsControl x:Name="IcRgbDevices">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardDarkHover}" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                                    <TextBlock Text="{Binding Vendor}" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Width="14" Height="14" CornerRadius="7" Background="{Binding CurrentHexColor}" BorderBrush="White" BorderThickness="1" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
