<UserControl x:Class="OmniWin.UI.Views.FirewallMonitorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="1.8*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛡️ Cortafuegos Visual &amp; Monitor de Sockets TCP" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                        <Border Background="#3B1219" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="1-CLICK PROCESS BLOCK" FontSize="9.5" FontWeight="Bold" Foreground="#FCA5A5" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Inspecciona cada socket TCP abierto en tu equipo mapeado a su ejecutable real mediante la tabla MIB nativa de Windows. Bloquea apps sospechosas en el Firewall con un solo clic."
                               FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="TxtSearchFilter" Width="180" Background="#090D18" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorder}" Padding="8,6" FontSize="11.5" Margin="0,0,8,0" Tag="Buscar proceso o IP..." TextChanged="TxtSearchFilter_TextChanged" />
                    <Button x:Name="BtnRefreshSockets" Content="🔄 Actualizar Sockets" Click="BtnRefreshSockets_Click" Padding="12,7" FontSize="12" Margin="0,0,8,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- TOP GRID: ACTIVE TCP CONNECTIONS -->
        <Border Grid.Row="1" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="CONEXIONES TCP ACTIVAS EN TIEMPO REAL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8" />

                <DataGrid Grid.Row="1" x:Name="DgConnections" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0" RowBackground="#090D18" AlternatingRowBackground="#0E1422"
                          Foreground="{DynamicResource TextPrimary}" GridLinesVisibility="None" HeadersVisibility="Column"
                          SelectionMode="Single" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Proceso" Binding="{Binding ProcessName}" Width="160" />
                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70" />
                        <DataGridTextColumn Header="Punto Local" Binding="{Binding LocalEndpoint}" Width="180" />
                        <DataGridTextColumn Header="Punto Remoto" Binding="{Binding RemoteEndpoint}" Width="180" />
                        <DataGridTextColumn Header="Estado TCP" Binding="{Binding State}" Width="110" />
                        <DataGridTextColumn Header="Ruta del Ejecutable" Binding="{Binding ExecutablePath}" Width="*" />
                        <DataGridTemplateColumn Header="Acción Firewall" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🚫 Bloquear" Click="BtnBlockProcess_Click" Style="{DynamicResource SecondaryButton}" Padding="8,3" FontSize="10.5" Foreground="#EF4444" BorderBrush="#EF4444" Margin="2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- SPLITTER -->
        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- BOTTOM GRID: BLOCKED FIREWALL RULES -->
        <Border Grid.Row="3" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="REGLAS DE BLOQUEO DE OMNIWIN EN WINDOWS FIREWALL" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtBlockedCount" Text="(0 bloqueados)" FontSize="11" Foreground="{DynamicResource Accent}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <DataGrid Grid.Row="1" x:Name="DgBlockedRules" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0" RowBackground="#090D18" AlternatingRowBackground="#0E1422"
                          Foreground="{DynamicResource TextPrimary}" GridLinesVisibility="None" HeadersVisibility="Column"
                          SelectionMode="Single" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Regla" Binding="{Binding RuleName}" Width="240" />
                        <DataGridTextColumn Header="Ruta del Ejecutable" Binding="{Binding ProgramPath}" Width="*" />
                        <DataGridTextColumn Header="Fecha Bloqueo" Binding="{Binding CreatedAt, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="140" />
                        <DataGridTemplateColumn Header="Desbloquear" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✅ Permitir" Click="BtnUnblockRule_Click" Style="{DynamicResource SecondaryButton}" Padding="8,3" FontSize="10.5" Foreground="#10B981" BorderBrush="#10B981" Margin="2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- FOOTER -->
        <Border Grid.Row="4" Background="#090D18" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtFirewallStatus" Text="Sockets TCP cargados desde la API nativa de Windows iphlpapi.dll." FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />
                <TextBlock x:Name="TxtConnectionsCount" Grid.Column="1" Text="Total conexiones: 0" FontSize="11" Foreground="{DynamicResource TextMuted}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
