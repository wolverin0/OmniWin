<UserControl x:Class="OmniWin.UI.Views.IncidentInvestigatorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <!-- Header Card -->
            <RowDefinition Height="Auto" />
            <!-- Main Content: Incidents List + Details -->
            <RowDefinition Height="*" />
            <!-- Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER CARD -->
        <Border Grid.Row="0" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✈️ Caja Negra &amp; Análisis Forense de BSOD" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                        <Border Background="#3B1219" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="AUDITORÍA DE CRASHES" FontSize="9.5" FontWeight="Bold" Foreground="#FCA5A5" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Diagnóstico automático de pantallazos azules (BugChecks), cortes de energía (Kernel-Power Event 41), volcados minidump y órdenes de reinicio."
                               FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="CmbCategoryFilter" Width="150" Padding="8,5" Margin="0,0,8,0" Background="#090D18" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorder}" SelectionChanged="CmbCategoryFilter_SelectionChanged">
                        <ComboBoxItem Content="Todos los Incidentes" IsSelected="True" />
                        <ComboBoxItem Content="Solo Pantallazos (BSOD)" />
                        <ComboBoxItem Content="Solo Cortes de Energía" />
                        <ComboBoxItem Content="Solo Reinicios / Apagados" />
                    </ComboBox>
                    <Button x:Name="BtnRefreshIncidents" Content="🔄 Escanear Incidentes" Click="BtnRefreshIncidents_Click" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0" Padding="12,6" FontSize="12" />
                    <Button x:Name="BtnOpenMinidumpFolder" Content="📂 Ver Minidumps" Click="BtnOpenMinidumpFolder_Click" Style="{DynamicResource SecondaryButton}" Padding="12,6" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT: GRID 2 ROWS (LIST + DETAILS) -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <!-- Top: DataGrid of Incidents -->
            <Border Grid.Row="0" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="12">
                <DataGrid x:Name="DgIncidents" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0" GridLinesVisibility="None" HeadersVisibility="Column"
                          Foreground="{DynamicResource TextPrimary}" RowBackground="Transparent"
                          SelectionChanged="DgIncidents_SelectionChanged" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha y Hora" Binding="{Binding Timestamp, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="150" />
                        <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="110" />
                        <DataGridTextColumn Header="Incidente / Evento" Binding="{Binding EventTitle}" Width="280" />
                        <DataGridTextColumn Header="Código BugCheck" Binding="{Binding BugcheckCodeHex}" Width="120" />
                        <DataGridTextColumn Header="Causa / Diagnóstico Rápido" Binding="{Binding DiagnosticVerdict}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeNS" />

            <!-- Bottom: Forensic Breakdown Card -->
            <Border Grid.Row="2" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PnlIncidentDetail">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtDetailTitle" Text="Selecciona un incidente para ver el informe forense detallado" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock x:Name="TxtDetailCode" Text="" FontSize="13" FontWeight="Bold" Foreground="#F59E0B" Margin="10,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="BtnCopyDiagnostic" Content="📋 Copiar Diagnóstico" Click="BtnCopyDiagnostic_Click" Style="{DynamicResource SecondaryButton}" Padding="10,4" FontSize="11" />
                        </Grid>

                        <Border Background="#090D18" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="VEREDICTO DIAGNÓSTICO DEL SISTEMA" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,4" />
                                <TextBlock x:Name="TxtDetailVerdict" Text="No hay incidente seleccionado." FontSize="12.5" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                                <Separator Background="{DynamicResource CardBorder}" Margin="0,8,0,8" />
                                <TextBlock Text="RECOMENDACIÓN TÉCNICA SUGERIDA" FontSize="11" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,4" />
                                <TextBlock x:Name="TxtDetailRecommendation" Text="Selecciona una fila superior para ver acciones recomendadas." FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="DETALLES TÉCNICOS BRUTOS (LOG / DUMP PATH)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,4" />
                        <TextBox x:Name="TxtDetailRaw" Text="" IsReadOnly="True" Background="#050811" Foreground="#94A3B8" FontFamily="Consolas" FontSize="11" Padding="8" BorderThickness="1" BorderBrush="{DynamicResource CardBorder}" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="#090D18" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0">
            <TextBlock x:Name="TxtStatus" Text="Listo para inspeccionar incidentes y volcados." FontSize="12" Foreground="{DynamicResource TextSecondary}" />
        </Border>
    </Grid>
</UserControl>
