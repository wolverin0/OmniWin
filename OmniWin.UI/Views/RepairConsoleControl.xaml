<UserControl x:Class="OmniWin.UI.Views.RepairConsoleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1050"
             Background="{StaticResource BgDark}"
             Foreground="{StaticResource TextPrimary}"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header & Action Controls -->
            <RowDefinition Height="Auto" />
            <!-- Progress Bar & Status -->
            <RowDefinition Height="Auto" />
            <!-- Main Content (Steps + Console) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Actions -->
        <Border Grid.Row="0" Background="{StaticResource CardDark}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#0284C7" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                            <TextBlock Text="🛠️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Pipeline Secuencial de Reparación de Windows" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                <Border Background="#1E293B" CornerRadius="4" Margin="10,2,0,2" Padding="6,1">
                                    <TextBlock Text="RepairKit Pro" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Protocolo estricto Microsoft: ScanHealth ➔ RestoreHealth ➔ SFC ➔ WinSxS ResetBase ➔ WinUpdate ➔ Winsock/WMI" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Admin Badge / Restart -->
                    <Border Grid.Column="1" x:Name="BadgeAdmin" Background="#064E3B" CornerRadius="6" Padding="10,6" Cursor="Hand" MouseDown="BadgeAdmin_MouseDown" ToolTip="Haz clic para reiniciar como Administrador">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtAdminIcon" Text="🛡️" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtAdminStatus" Text="Administrador Activo ✔" FontSize="11" FontWeight="SemiBold" Foreground="#34D399" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Action Buttons -->
                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                    <Button x:Name="BtnRunFull" Content="⚡ Iniciar Reparación Integral Secuencial" Click="BtnRunFull_Click" Style="{DynamicResource PrimaryButton}" Margin="0,0,10,0" Padding="14,7" FontSize="12" FontWeight="Bold" />
                    <Button x:Name="BtnRunSfc" Content="🛡️ Ejecutar Solo SFC" Click="BtnRunSfc_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Padding="12,7" FontSize="12" />
                    <Button x:Name="BtnRunWinUpdate" Content="🔄 Ejecutar Solo WinUpdate Reset" Click="BtnRunWinUpdate_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Padding="12,7" FontSize="12" />
                    <Button x:Name="BtnCancel" Content="🛑 Cancelar Operación" Click="BtnCancel_Click" Background="#EF4444" IsEnabled="False" Padding="12,7" FontSize="12" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Progress Bar & Status -->
        <Border Grid.Row="1" Background="{StaticResource CardDark}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock x:Name="TxtCurrentAction" Text="Listo para iniciar reparación del sistema." FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock x:Name="TxtOverallPercentage" Text="0%" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Accent}" />
                </Grid>

                <ProgressBar Grid.Row="1" x:Name="PbOverall" Value="0" Maximum="100" Height="8" Foreground="#0284C7" Background="#090D16" />
            </Grid>
        </Border>

        <!-- Main Content: Left Steps + Right Console -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="280" MaxWidth="440" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- Left Steps Panel -->
            <Border Grid.Column="0" Background="{StaticResource CardDark}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="PASOS DEL PIPELINE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                        <Border HorizontalAlignment="Right" Background="#1E293B" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="6 Pasos Oficiales" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" />
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="IcSteps">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="10" CornerRadius="6"
                                            Background="{Binding CardBackground}"
                                            BorderBrush="{Binding CardBorderBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Step Number Circle -->
                                            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                                                    Background="{Binding NumberBadgeBg}" VerticalAlignment="Top" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding StepNumber}" FontSize="12" FontWeight="Bold"
                                                           Foreground="{Binding NumberBadgeFg}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Details -->
                                            <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
                                                <Border Background="#050811" CornerRadius="4" Padding="6,2" Margin="0,4,0,4" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Command}" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource Accent}" TextTrimming="CharacterEllipsis" MaxWidth="210" />
                                                </Border>
                                                <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                                            </StackPanel>

                                            <!-- Status Pill -->
                                            <Border Grid.Column="2" Background="{Binding StatusBg}" CornerRadius="6" Padding="8,4" VerticalAlignment="Top" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding StatusText}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding StatusColor}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- GridSplitter -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Width="4" Background="Transparent" />

            <!-- Right Terminal Console Panel -->
            <Border Grid.Column="2" Background="{StaticResource CardDark}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Terminal Top Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1E293B" CornerRadius="4" Padding="6,3" Margin="0,0,8,0">
                                <TextBlock Text=">_" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Foreground="#34D399" />
                            </Border>
                            <TextBlock Text="CONSOLA DE SALIDA" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkAutoScroll" Content="Auto-scroll" IsChecked="True" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="11" />
                            <Button x:Name="BtnCopyLogs" Content="📋 Copiar Logs" Click="BtnCopyLogs_Click" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0" />
                            <Button x:Name="BtnClearLogs" Content="🧹 Limpiar" Click="BtnClearLogs_Click" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" />
                        </StackPanel>
                    </Grid>

                    <!-- Terminal Console Body -->
                    <Border Grid.Row="1" Background="#050811" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6">
                        <TextBox x:Name="TxtConsole"
                                 Background="#050811"
                                 Foreground="#22D3EE"
                                 FontFamily="Consolas, Cascadia Code, Courier New, monospace"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 BorderThickness="0"
                                 Padding="12" />
                    </Border>

                    <!-- Footer Info -->
                    <DockPanel Grid.Row="2" Margin="0,8,0,0" LastChildFill="True">
                        <TextBlock Text="Terminal Engine • System32" DockPanel.Dock="Right" FontSize="11" Foreground="#475569" FontFamily="Consolas" Margin="8,0,0,0" />
                        <TextBlock x:Name="TxtConsoleFooter" Text="Líneas procesadas en tiempo real vía stdio." FontSize="11" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>