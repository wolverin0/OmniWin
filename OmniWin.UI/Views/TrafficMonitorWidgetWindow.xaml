<Window x:Class="OmniWin.UI.Views.TrafficMonitorWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniWin Traffic &amp; System Widget"
        Height="40" Width="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseDoubleClick="Window_MouseDoubleClick">

    <!-- Draggable Pill Border -->
    <Border Background="#E6080D1A" BorderBrush="#2A3B5C" BorderThickness="1.2" CornerRadius="20" Padding="14,0" Cursor="SizeAll">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <!-- Network Speeds -->
                <ColumnDefinition Width="Auto" />
                <!-- Separator -->
                <ColumnDefinition Width="Auto" />
                <!-- CPU Temp -->
                <ColumnDefinition Width="Auto" />
                <!-- Separator -->
                <ColumnDefinition Width="Auto" />
                <!-- GPU Temp -->
                <ColumnDefinition Width="Auto" />
                <!-- Separator -->
                <ColumnDefinition Width="Auto" />
                <!-- RAM Usage -->
                <ColumnDefinition Width="Auto" />
                <!-- Spacer -->
                <ColumnDefinition Width="*" />
                <!-- Close Button -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 1. Network Download & Upload -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="↓ " FontSize="11" FontWeight="Bold" Foreground="#10B981" />
                <TextBlock x:Name="TxtDownloadSpeed" Text="0 KB/s" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,8,0" />
                <TextBlock Text="↑ " FontSize="11" FontWeight="Bold" Foreground="#38BDF8" />
                <TextBlock x:Name="TxtUploadSpeed" Text="0 KB/s" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" />
            </StackPanel>

            <Rectangle Grid.Column="1" Width="1" Height="14" Fill="#334155" Margin="10,0" VerticalAlignment="Center" />

            <!-- 2. CPU Temperature -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="CPU " FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtCpuTemp" Text="--°C" FontSize="11.5" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" />
            </StackPanel>

            <Rectangle Grid.Column="3" Width="1" Height="14" Fill="#334155" Margin="10,0" VerticalAlignment="Center" />

            <!-- 3. GPU Temperature -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="GPU " FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtGpuTemp" Text="--°C" FontSize="11.5" FontWeight="Bold" Foreground="#A855F7" VerticalAlignment="Center" />
            </StackPanel>

            <Rectangle Grid.Column="5" Width="1" Height="14" Fill="#334155" Margin="10,0" VerticalAlignment="Center" />

            <!-- 4. RAM Usage -->
            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="RAM " FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtRamPercent" Text="--%" FontSize="11.5" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center" />
            </StackPanel>

            <!-- 5. Close / Hide Button -->
            <Button Grid.Column="8" Content="✕" Click="BtnClose_Click" Cursor="Hand" Background="Transparent" Foreground="#64748B" BorderThickness="0" FontSize="11" Padding="4,2" Margin="4,0,0,0" ToolTip="Cerrar widget flotante" />
        </Grid>
    </Border>
</Window>
