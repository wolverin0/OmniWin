<UserControl x:Class="OmniWin.UI.Views.AsrManagerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1000"
             Foreground="{StaticResource TextPrimary}"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <UserControl.Resources>
        <!-- Segmented Action Button Style -->
        <Style x:Key="SegmentedBtnStyle" TargetType="Button">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Defender Status -->
            <RowDefinition Height="Auto" />
            <!-- Admin Alert Banner -->
            <RowDefinition Height="Auto" />
            <!-- Toolbar & Profiles -->
            <RowDefinition Height="Auto" />
            <!-- Rules List -->
            <RowDefinition Height="*" />
            <!-- Footer Status -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. ENCABEZADO: ESTADO GENERAL DE MICROSOFT DEFENDER -->
        <Border Grid.Row="0" Background="{StaticResource CardDark}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title and Description -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#065F46" CornerRadius="8" Width="42" Height="42" Margin="0,0,14,0">
                        <TextBlock Text="🛡️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Microsoft Defender • Attack Surface Reduction (ASR)" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                            <Border Background="#064E3B" CornerRadius="4" Margin="10,2,0,2" Padding="6,2">
                                <TextBlock Text="DefenderUI Native" FontSize="10" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Mitigación proactiva de 16 vectores de ataque (exploits en Office, scripts ofuscados, robo de credenciales LSASS y ransomware)." 
                                   FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Right: Defender Status Metrics -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Real-Time Protection Badge -->
                    <Border Background="#0A1E17" BorderBrush="#064E3B" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="PROTECCIÓN REAL-TIME" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Ellipse x:Name="EllRealTime" Width="7" Height="7" Fill="#10B981" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtRealTimeStatus" Text="Activo ✔" FontSize="11" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Active Rules Counter -->
                    <Border Background="{StaticResource CardDark}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="REGLAS ACTIVAS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                            <TextBlock x:Name="TxtActiveRulesCount" Text="-- / 16" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,2,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Breakdown: Blocked vs Audited -->
                    <Border Background="{StaticResource CardDark}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,6">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="DISTRIBUCIÓN" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock x:Name="TxtBlockedCount" Text="0 Bloqueadas" FontSize="11" FontWeight="SemiBold" Foreground="#34D399" />
                                <TextBlock Text=" • " FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                <TextBlock x:Name="TxtAuditedCount" Text="0 Auditar" FontSize="11" FontWeight="SemiBold" Foreground="#FBBF24" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. ALERTA DE PERMISOS DE ADMINISTRADOR (SI APLICA) -->
        <Border x:Name="AdminBanner" Grid.Row="1" Background="#451A03" BorderBrush="#B45309" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚠️" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="OmniWin se está ejecutando sin permisos elevados. La lectura de reglas es funcional, pero para modificar el estado de Microsoft Defender se requieren permisos de Administrador." 
                               FontSize="12" Foreground="#FDE68A" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Content="🛡️ Reiniciar como Administrador" Click="BtnRestartAsAdmin_Click" 
                        Background="#D97706" Foreground="White" Padding="12,5" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 3. BARRA DE HERRAMIENTAS: PERFILES RÁPIDOS, CATEGORÍAS Y BUSCADOR -->
        <Border Grid.Row="2" Background="{StaticResource CardDark}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Row: Perfiles Rápidos + Search + Refresh -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Perfiles Rápidos -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Perfiles:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        
                        <Button x:Name="BtnProfileMaxProtection" Content="🛡️ Máxima Protección" Click="BtnProfileMaxProtection_Click" 
                                Background="#0284C7" Foreground="White" Padding="12,6" FontSize="11.5" Margin="0,0,8,0" 
                                ToolTip="Activa las 16 reglas ASR en modo Bloquear para máxima seguridad del sistema." />

                        <Button x:Name="BtnProfileDeveloper" Content="💻 Modo Desarrollador / Gamer" Click="BtnProfileDeveloper_Click" 
                                Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="11.5" Margin="0,0,8,0" 
                                ToolTip="Bloquea LSASS, ransomware y scripts maliciosos, pero sin bloquear prevalencia de ejecutables." />

                        <Button x:Name="BtnProfileDisableAll" Content="⚪ Desactivar Todas" Click="BtnProfileDisableAll_Click" 
                                Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="11.5" 
                                ToolTip="Desactiva todas las 16 reglas ASR de Microsoft Defender." />
                    </StackPanel>

                    <!-- Right: Buscador y Actualizar -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Search Input -->
                        <Border Background="#090D16" CornerRadius="6" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="8,4" Margin="0,0,8,0" Width="220">
                            <Grid>
                                <TextBlock Text="🔍 Buscar regla o GUID..." FontSize="11" Foreground="#64748B" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtSearchFilter}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="TxtSearchFilter" TextChanged="TxtSearchFilter_TextChanged" Background="Transparent" Foreground="{StaticResource TextPrimary}" 
                                         BorderThickness="0" FontSize="11" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Refresh Button -->
                        <Button x:Name="BtnRefresh" Content="🔄 Actualizar" Click="BtnRefresh_Click" 
                                Style="{StaticResource SecondaryButton}" Padding="10,5" FontSize="11" />
                    </StackPanel>
                </Grid>

                <!-- Bottom Row: Category Filter Pills -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Categorías:" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button x:Name="BtnCatAll" Content="🌟 Todas" Click="BtnCategoryFilter_Click" Tag="Todas las Categorías" Padding="10,4" FontSize="11" Margin="0,0,6,0" Background="#0284C7" Foreground="White" />
                    <Button x:Name="BtnCatOffice" Content="📄 Office &amp; Apps" Click="BtnCategoryFilter_Click" Tag="Office &amp; Aplicaciones" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Margin="0,0,6,0" />
                    <Button x:Name="BtnCatLsass" Content="🔑 Credenciales LSASS" Click="BtnCategoryFilter_Click" Tag="Credenciales &amp; Sistema" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Margin="0,0,6,0" />
                    <Button x:Name="BtnCatMalware" Content="🛡️ Malware &amp; USB" Click="BtnCategoryFilter_Click" Tag="Protección Malware" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Margin="0,0,6,0" />
                    <Button x:Name="BtnCatScripts" Content="📜 Scripts &amp; Persistencia" Click="BtnCategoryFilter_Click" Tag="Scripts &amp; Persistencia" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. LISTADO DE LAS 16 REGLAS ASR CON SELECTOR INTERACTIVO [Desactivado | Auditar | Bloquear] -->
        <Border Grid.Row="3" Background="{StaticResource CardDark}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="IcAsrRules">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#090D16" CornerRadius="6" Padding="14" Margin="0,0,0,8" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- Info Column -->
                                        <ColumnDefinition Width="*" />
                                        <!-- Spacer -->
                                        <ColumnDefinition Width="16" />
                                        <!-- Interactive Selector Column -->
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Rule Details -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <!-- Title and Badges -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                            
                                            <!-- Category Badge -->
                                            <Border Background="{Binding CategoryBadgeBackground}" CornerRadius="4" Margin="8,0,0,0" Padding="6,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding CategoryBadgeForeground}" />
                                            </Border>

                                            <!-- Current State Badge -->
                                            <Border Background="{Binding StatusBadgeBackground}" CornerRadius="4" Margin="6,0,0,0" Padding="6,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{Binding StatusBadgeForeground}" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Description -->
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,5" />

                                        <!-- GUID / Technical Info -->
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="GUID: " FontSize="10" FontWeight="SemiBold" Foreground="#64748B" />
                                            <TextBlock Text="{Binding Guid}" FontFamily="Consolas" FontSize="10" Foreground="#64748B" />
                                            <TextBlock Text=" • Tipo: " FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding MitigationType}" FontSize="10" Foreground="#64748B" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Interactive 3-Way Selector [Desactivado | Auditar | Bloquear] -->
                                    <Border Grid.Column="2" Background="#0B1329" CornerRadius="6" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Desactivado (0) -->
                                            <Button Content="Desactivado" Click="BtnSetRuleDisabled_Click" Tag="{Binding}"
                                                    Style="{StaticResource SegmentedBtnStyle}"
                                                    Background="{Binding DisabledButtonBackground}" 
                                                    Foreground="{Binding DisabledButtonForeground}" 
                                                    Padding="10,6" Margin="1"
                                                    ToolTip="Desactiva la regla ASR." />

                                            <!-- Auditar (2) -->
                                            <Button Content="Auditar" Click="BtnSetRuleAudit_Click" Tag="{Binding}"
                                                    Style="{StaticResource SegmentedBtnStyle}"
                                                    Background="{Binding AuditButtonBackground}" 
                                                    Foreground="{Binding AuditButtonForeground}" 
                                                    Padding="10,6" Margin="1"
                                                    ToolTip="Registra detecciones de eventos sin bloquear la ejecución." />

                                            <!-- Bloquear (1) -->
                                            <Button Content="Bloquear" Click="BtnSetRuleBlock_Click" Tag="{Binding}"
                                                    Style="{StaticResource SegmentedBtnStyle}"
                                                    Background="{Binding BlockButtonBackground}" 
                                                    Foreground="{Binding BlockButtonForeground}" 
                                                    Padding="10,6" Margin="1"
                                                    ToolTip="Bloquea activamente cualquier ejecución que infrinja la regla." />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 5. BARRA DE ESTADO / LOGS INFERIOR -->
        <Border Grid.Row="4" Background="#090D16" CornerRadius="6" Padding="10,8" Margin="0,10,0,0" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatusLog" Text="Listo. Reglas ASR de Microsoft Defender consultadas correctamente." FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Microsoft Defender Exploit Guard • Reglas ASR v1.0" FontSize="10" Foreground="#64748B" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
