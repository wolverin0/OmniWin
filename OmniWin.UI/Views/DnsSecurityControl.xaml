<UserControl x:Class="OmniWin.UI.Views.DnsSecurityControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🌐 DNS Seguro (DoH) &amp; Bloqueador Masivo HOSTS" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                        <Border Background="#062E21" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PRIVACIDAD &amp; LATENCIA" FontSize="9.5" FontWeight="Bold" Foreground="#34D399" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Compara la latencia en milisegundos de los resolvers mundiales más veloces (Cloudflare, Quad9, Google, AdGuard) y bloquea 60.000+ dominios de telemetría directamente en HOSTS."
                               FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnRunBenchmark" Content="⚡ Benchmark de Latencia" Click="BtnRunBenchmark_Click" Padding="14,7" FontSize="12" Margin="0,0,8,0" />
                    <Button x:Name="BtnRestoreDhcp" Content="🔄 Restaurar DNS (DHCP)" Click="BtnRestoreDhcp_Click" Style="{DynamicResource SecondaryButton}" Padding="12,7" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- PROVIDERS BENCHMARK GRID -->
        <Border Grid.Row="1" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="PROVEEDORES DNS DE ALTA VELOCIDAD Y CIFRADO DOH" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtBenchmarkTime" Text="" FontSize="11" Foreground="{DynamicResource Accent}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <DataGrid Grid.Row="1" x:Name="DgProviders" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0" RowBackground="{DynamicResource CardDarkHover}" AlternatingRowBackground="{DynamicResource CardDark}"
                          Foreground="{DynamicResource TextPrimary}" GridLinesVisibility="None" HeadersVisibility="Column"
                          SelectionMode="Single" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Proveedor" Binding="{Binding Name}" Width="160" />
                        <DataGridTextColumn Header="IP Primaria" Binding="{Binding PrimaryIp}" Width="120" />
                        <DataGridTextColumn Header="IP Secundaria" Binding="{Binding SecondaryIp}" Width="120" />
                        <DataGridTemplateColumn Header="Latencia" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#062E21" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="2">
                                        <TextBlock Text="{Binding LatencyText}" Foreground="#34D399" FontWeight="Bold" FontSize="11" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Características" Binding="{Binding Description}" Width="*" />
                        <DataGridTemplateColumn Header="Configurar" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🚀 Aplicar" Click="BtnApplyDns_Click" Padding="8,3" FontSize="10.5" Margin="2" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- HOSTS MASSIVE BLOCKER SECTION -->
        <Border Grid.Row="2" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🛡️ Bloqueador Masivo por HOSTS (StevenBlack Unified)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                        <Border x:Name="BadgeHostsStatus" Background="#062E21" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                            <TextBlock x:Name="TxtHostsBadge" Text="INACTIVO" FontSize="9.5" FontWeight="Bold" Foreground="#34D399" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtHostsDetails" Text="Sincroniza la lista unificada oficial para redirigir a 0.0.0.0 dominios de malware, publicidad invasiva y telemetría de Windows antes de que salgan de tu tarjeta de red."
                               FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnSyncHosts" Content="⬇️ Sincronizar HOSTS (60k+ reglas)" Click="BtnSyncHosts_Click" Padding="14,8" FontSize="12" Margin="0,0,8,0" />
                    <Button x:Name="BtnRestoreHosts" Content="🧹 Limpiar HOSTS" Click="BtnRestoreHosts_Click" Style="{DynamicResource SecondaryButton}" Padding="12,8" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- FOOTER -->
        <Border Grid.Row="3" Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,12,0,0">
            <TextBlock x:Name="TxtDnsFooter" Text="OmniWin DNS Control: Al aplicar se vacía automáticamente la caché de resolución DNS (ipconfig /flushdns)." FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />
        </Border>
    </Grid>
</UserControl>
