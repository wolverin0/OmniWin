<UserControl x:Class="OmniWin.UI.Views.ProcessExplorerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1050"
             Background="{StaticResource BgDark}"
             Foreground="{StaticResource TextPrimary}"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Panel Izquierdo: Lista de Procesos -->
            <ColumnDefinition Width="460" MinWidth="340" />
            <!-- Separador redimensionable -->
            <ColumnDefinition Width="6" />
            <!-- Panel Derecho: Diagnóstico Forense y Pestañas -->
            <ColumnDefinition Width="*" MinWidth="420" />
        </Grid.ColumnDefinitions>

        <!-- PANEL IZQUIERDO: LISTADO Y BÚSQUEDA -->
        <Border Grid.Column="0" Background="{StaticResource CardDark}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Encabezado del Panel -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Árbol de Procesos" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                            <Border Background="#1E293B" CornerRadius="4" Margin="8,1,0,1" Padding="6,1">
                                <TextBlock x:Name="TxtProcCountBadge" Text="0 procesos" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Jerarquía Parent PID (PPID) y telemetría en vivo" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                    </StackPanel>

                    <Button Content="🔄 Actualizar" Click="BtnRefreshProcs_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Padding="10,4" FontSize="11" />
                </Grid>

                <!-- Barra de Búsqueda y Filtros -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtSearchProc" TextChanged="TxtSearchProc_TextChanged" 
                             Background="#090D16" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource CardBorder}" 
                             Padding="8,6" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="🔍 Filtrar nombre o PID..." Foreground="#64748B" FontSize="12" IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=TxtSearchProc}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <CheckBox x:Name="ChkTreeMode" Grid.Column="1" Content="Jerarquía" IsChecked="True" Checked="ChkTreeMode_Changed" Unchecked="ChkTreeMode_Changed" 
                              VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                </Grid>

                <!-- DataGrid de Procesos -->
                <DataGrid Grid.Row="2" x:Name="DgProcessList" SelectionChanged="DgProcessList_SelectionChanged"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          Background="Transparent" BorderThickness="0" GridLinesVisibility="None" HeadersVisibility="Column"
                          Foreground="{StaticResource TextPrimary}" RowBackground="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Proceso (Árbol)" Binding="{Binding IndentedName}" Width="*" />
                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="56" />
                        <DataGridTextColumn Header="PPID" Binding="{Binding ParentPid}" Width="54" />
                        <DataGridTextColumn Header="RAM" Binding="{Binding MemoryMB, StringFormat={}{0:N0} MB}" Width="68" />
                        <DataGridTextColumn Header="Handles" Binding="{Binding HandleCount}" Width="60" />
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu Background="#131B2E" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource CardBorder}">
                            <MenuItem Header="❌ Terminar Proceso" Click="MenuKillProc_Click" />
                            <MenuItem Header="🌳 Terminar Árbol de Procesos" Click="MenuKillTree_Click" />
                            <Separator Background="{StaticResource CardBorder}" />
                            <MenuItem Header="📋 Copiar PID" Click="MenuCopyPid_Click" />
                            <MenuItem Header="🔄 Refrescar Lista" Click="BtnRefreshProcs_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>

                <!-- Pie de estado del listado -->
                <Border Grid.Row="3" Background="#090D16" CornerRadius="4" Padding="8,5" Margin="0,8,0,0" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                    <TextBlock x:Name="TxtProcListStatus" Text="Cargando procesos..." FontSize="11" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>
        </Border>

        <!-- GridSplitter redimensionable -->
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent" Cursor="SizeWE" />

        <!-- PANEL DERECHO: DIAGNÓSTICO FORENSE DEL PROCESO SELECCIONADO -->
        <Border Grid.Column="2" Background="{StaticResource CardDark}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Header Info del Proceso Seleccionado -->
                    <RowDefinition Height="Auto" />
                    <!-- TabControl de Diagnóstico -->
                    <RowDefinition Height="*" />
                    <!-- Status / Log Footer -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Estado Inicial si no hay proceso seleccionado -->
                <Border Grid.Row="0" Grid.RowSpan="3" x:Name="PnlNoSelection" Background="{StaticResource CardDark}" Visibility="Visible" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                        <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock Text="Selecciona un proceso" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6" />
                        <TextBlock Text="Haz clic en cualquier proceso del listado izquierdo para inspeccionar sus módulos DLL cargados, sockets de red TCP activos y telemetría de memoria virtual estilo Process Hacker."
                                   TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </Border>

                <!-- Detalle cuando hay selección -->
                <Grid Grid.Row="0" x:Name="PnlSelectedHeader" Visibility="Collapsed" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtSelectedProcName" Text="Proceso.exe" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                            <Border Background="#1E293B" CornerRadius="4" Margin="10,0,0,0" Padding="6,2">
                                <TextBlock x:Name="TxtSelectedProcPid" Text="PID: 0000" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                            </Border>
                            <Border Background="#1E293B" CornerRadius="4" Margin="6,0,0,0" Padding="6,2">
                                <TextBlock x:Name="TxtSelectedProcPpid" Text="PPID: 0000" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtSelectedProcPath" Text="C:\Windows\System32\..." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnRefreshDetails" Content="🔄 Refrescar" Click="BtnRefreshDetails_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="10,5" FontSize="11" />
                        <Button x:Name="BtnKillSelectedProc" Content="❌ Terminar Proceso" Click="BtnKillSelectedProc_Click" Background="#EF4444" Padding="12,6" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>

                <!-- TABCONTROL DETALLADO -->
                <TabControl Grid.Row="1" x:Name="TcProcessDetails" Visibility="Collapsed">
                    
                    <!-- PESTAÑA 1: MÓDULOS DLL -->
                    <TabItem Header="📦 Módulos DLL">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock x:Name="TxtModulesSummary" Text="0 módulos DLL mapeados" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBox x:Name="TxtFilterModules" TextChanged="TxtFilterModules_TextChanged" Width="220" HorizontalAlignment="Right"
                                         Background="#090D16" Foreground="{StaticResource TextPrimary}" BorderBrush="{StaticResource CardBorder}" 
                                         Padding="6,4" FontSize="11" />
                                <TextBlock Text="🔍 Filtrar DLLs..." Foreground="#64748B" FontSize="11" IsHitTestVisible="False" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtFilterModules}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <DataGrid Grid.Row="1" x:Name="DgModules" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="Transparent" BorderThickness="0" GridLinesVisibility="None" HeadersVisibility="Column"
                                      Foreground="{StaticResource TextPrimary}" RowBackground="Transparent">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Módulo" Binding="{Binding ModuleName}" Width="150" />
                                    <DataGridTextColumn Header="Versión" Binding="{Binding FileVersion}" Width="100" />
                                    <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="160" />
                                    <DataGridTextColumn Header="Compañía" Binding="{Binding Company}" Width="130" />
                                    <DataGridTextColumn Header="Base" Binding="{Binding BaseAddress}" Width="120" />
                                    <DataGridTextColumn Header="Tamaño" Binding="{Binding SizeText}" Width="75" />
                                    <DataGridTextColumn Header="Ruta Completa" Binding="{Binding FilePath}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- PESTAÑA 2: CONEXIONES DE RED -->
                    <TabItem Header="🌐 Conexiones de Red">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock x:Name="TxtTcpSummary" Text="0 sockets TCP en tiempo real" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                <Button Content="🔄 Refrescar Sockets" Click="BtnRefreshSockets_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Padding="8,4" FontSize="11" />
                            </Grid>

                            <DataGrid Grid.Row="1" x:Name="DgTcpConnections" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="Transparent" BorderThickness="0" GridLinesVisibility="None" HeadersVisibility="Column"
                                      Foreground="{StaticResource TextPrimary}" RowBackground="Transparent">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Dirección Local" Binding="{Binding LocalEndPoint}" Width="170" />
                                    <DataGridTextColumn Header="Dirección Remota" Binding="{Binding RemoteEndPoint}" Width="170" />
                                    <DataGridTemplateColumn Header="Estado TCP" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#1E293B" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEstablished}" Value="True">
                                                                    <Setter Property="Background" Value="#064E3B" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsListening}" Value="True">
                                                                    <Setter Property="Background" Value="#1E3A8A" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding State}" FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#CBD5E1" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEstablished}" Value="True">
                                                                        <Setter Property="Foreground" Value="#34D399" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsListening}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Puerto Local" Binding="{Binding LocalPort}" Width="90" />
                                    <DataGridTextColumn Header="Puerto Remoto" Binding="{Binding RemotePort}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- PESTAÑA 3: HILOS Y RENDIMIENTO -->
                    <TabItem Header="⚡ Hilos y Rendimiento">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <!-- Tarjetas de Métricas de Memoria Virtual -->
                                <RowDefinition Height="Auto" />
                                <!-- Listado de Hilos -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Metric Cards Grid -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Working Set Card -->
                                <Border Grid.Column="0" Background="#090D16" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="WORKING SET (RAM)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                                        <TextBlock x:Name="TxtWorkingSet" Text="0 MB" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,4,0,2" />
                                        <TextBlock x:Name="TxtPeakWorkingSet" Text="Pico: 0 MB" FontSize="10" Foreground="{StaticResource TextSecondary}" />
                                    </StackPanel>
                                </Border>

                                <!-- Private Bytes Card -->
                                <Border Grid.Column="1" Background="#090D16" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="3,0,3,0">
                                    <StackPanel>
                                        <TextBlock Text="PRIVATE BYTES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                                        <TextBlock x:Name="TxtPrivateBytes" Text="0 MB" FontSize="16" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,2" />
                                        <TextBlock x:Name="TxtPagedMemory" Text="Paginado: 0 MB" FontSize="10" Foreground="{StaticResource TextSecondary}" />
                                    </StackPanel>
                                </Border>

                                <!-- Handles Card -->
                                <Border Grid.Column="2" Background="#090D16" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="3,0,3,0">
                                    <StackPanel>
                                        <TextBlock Text="DESCRIPTORES (HANDLES)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                                        <TextBlock x:Name="TxtHandlesCount" Text="0" FontSize="16" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,2" />
                                        <TextBlock x:Name="TxtPageFaults" Text="Fallas pág: 0" FontSize="10" Foreground="{StaticResource TextSecondary}" />
                                    </StackPanel>
                                </Border>

                                <!-- Threads & CPU Card -->
                                <Border Grid.Column="3" Background="#090D16" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="HILOS DE EJECUCIÓN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                                        <TextBlock x:Name="TxtThreadsCount" Text="0 hilos" FontSize="16" FontWeight="Bold" Foreground="#A855F7" Margin="0,4,0,2" />
                                        <TextBlock x:Name="TxtCpuTime" Text="CPU: 00:00:00" FontSize="10" Foreground="{StaticResource TextSecondary}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Subsección de Hilos -->
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="HILOS ACTIVOS DEL PROCESO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />

                                <DataGrid Grid.Row="1" x:Name="DgThreads" AutoGenerateColumns="False" IsReadOnly="True"
                                          Background="Transparent" BorderThickness="0" GridLinesVisibility="None" HeadersVisibility="Column"
                                          Foreground="{StaticResource TextPrimary}" RowBackground="Transparent">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="TID" Binding="{Binding ThreadId}" Width="70" />
                                        <DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="90" />
                                        <DataGridTextColumn Header="Motivo Espera" Binding="{Binding WaitReason}" Width="120" />
                                        <DataGridTextColumn Header="Prioridad Base" Binding="{Binding BasePriority}" Width="95" />
                                        <DataGridTextColumn Header="Prioridad Dinámica" Binding="{Binding CurrentPriority}" Width="115" />
                                        <DataGridTextColumn Header="Tiempo CPU (ms)" Binding="{Binding TotalProcessorTimeMs, StringFormat={}{0:N0} ms}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>

                <!-- Footer Status -->
                <Border Grid.Row="2" Background="#090D16" CornerRadius="4" Padding="8,5" Margin="0,8,0,0" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                    <TextBlock x:Name="TxtDiagFooterStatus" Text="Listo para inspeccionar procesos del sistema." FontSize="11" Foreground="{StaticResource TextSecondary}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
