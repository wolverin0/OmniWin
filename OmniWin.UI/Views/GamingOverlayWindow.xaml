<Window x:Class="OmniWin.UI.Views.GamingOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniWin Gaming HUD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        FontFamily="Segoe UI Variable, Segoe UI, Consolas, sans-serif"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <LinearGradientBrush x:Key="OverlayBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E6090D16" Offset="0.0" />
            <GradientStop Color="#D80D1527" Offset="1.0" />
        </LinearGradientBrush>

        <Style x:Key="MiniMetricBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#1E293B" />
        </Style>

        <!-- High-Contrast Contour Effect for RivaTuner OSD Text over 3D Rendering -->
        <DropShadowEffect x:Key="OsdTextShadow" BlurRadius="2" ShadowDepth="1.5" Direction="315" Opacity="0.95" Color="#000000" />
    </Window.Resources>

    <!-- Main Container Card / Canvas -->
    <Border x:Name="RootBorder" 
            Background="{StaticResource OverlayBackground}" 
            BorderBrush="#38BDF8" 
            BorderThickness="1" 
            CornerRadius="10" 
            Padding="12,10"
            MinWidth="180">
        <Border.Effect>
            <DropShadowEffect x:Name="RootShadow" BlurRadius="18" ShadowDepth="3" Opacity="0.6" Color="#000000" />
        </Border.Effect>

        <StackPanel x:Name="MainStack">
            <!-- 1. Header with Drag Handle, Settings, Lock & Close (Hidden when locked in Riva mode) -->
            <Grid x:Name="HeaderBar" Margin="0,0,0,8" MouseLeftButtonDown="Header_MouseDown" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="DotPulse" Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtHudTitle" Text="OMNIWIN HUD" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                    <Border x:Name="BadgeMode" Background="#1E293B" CornerRadius="3" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtModeBadge" Text="CONFIGURACIÓN" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Settings Toggle Button -->
                    <Button x:Name="BtnToggleSettings" Content="⚙️" Click="BtnToggleSettings_Click" 
                            ToolTip="Personalizar estilo, métricas y transparencia del HUD" 
                            Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" Padding="5,2" Margin="0,0,4,0" FontSize="9.5" Cursor="Hand" />

                    <!-- Toggle Lock / Click-Through Button -->
                    <Button x:Name="BtnToggleLock" Content="🔒 Bloquear" Click="BtnToggleLock_Click" 
                            ToolTip="Bloquear: Los clics del mouse traspasan el HUD directamente al juego (Click-Through)" 
                            Background="#1E293B" Foreground="#38BDF8" BorderThickness="0" Padding="6,2" Margin="0,0,4,0" FontSize="9.5" Cursor="Hand" />
                    
                    <!-- Close / Hide Button -->
                    <Button x:Name="BtnCloseOverlay" Content="✕" Click="BtnCloseOverlay_Click" 
                            ToolTip="Ocultar Overlay (Usa Ctrl+Shift+O para alternar)" 
                            Background="Transparent" Foreground="#64748B" BorderThickness="0" Padding="4,2" FontSize="11" Cursor="Hand" />
                </StackPanel>
            </Grid>

            <!-- ============================================================== -->
            <!-- STYLE 0: RIVATUNER (RTSS) PURE TEXT FLOATING OSD (NO CARD)     -->
            <!-- ============================================================== -->
            <StackPanel x:Name="PanelRivaTuner" Visibility="Visible" Margin="0,2,0,2">
                <!-- GPU Row -->
                <TextBlock x:Name="RtssGpuRow" Effect="{StaticResource OsdTextShadow}" Margin="0,1" FontFamily="Consolas, Segoe UI">
                    <Run Text="GPU" FontWeight="Bold" Foreground="#CBD5E1" />
                    <Run Text=" : " Foreground="#64748B" />
                    <Run x:Name="RtssGpuVal" Text="--%" FontWeight="Bold" Foreground="#10B981" />
                    <Run Text="   " />
                    <Run x:Name="RtssGpuTemp" Text="--°C" FontWeight="Bold" Foreground="#38BDF8" />
                </TextBlock>

                <!-- CPU Row -->
                <TextBlock x:Name="RtssCpuRow" Effect="{StaticResource OsdTextShadow}" Margin="0,1" FontFamily="Consolas, Segoe UI">
                    <Run Text="CPU" FontWeight="Bold" Foreground="#CBD5E1" />
                    <Run Text=" : " Foreground="#64748B" />
                    <Run x:Name="RtssCpuVal" Text="--%" FontWeight="Bold" Foreground="#10B981" />
                    <Run Text="   " />
                    <Run x:Name="RtssCpuTemp" Text="--°C" FontWeight="Bold" Foreground="#38BDF8" />
                </TextBlock>

                <!-- RAM Row -->
                <TextBlock x:Name="RtssRamRow" Effect="{StaticResource OsdTextShadow}" Margin="0,1" FontFamily="Consolas, Segoe UI">
                    <Run Text="RAM" FontWeight="Bold" Foreground="#CBD5E1" />
                    <Run Text=" : " Foreground="#64748B" />
                    <Run x:Name="RtssRamVal" Text="-- GB" FontWeight="Bold" Foreground="#A855F7" />
                </TextBlock>

                <!-- Ping Row -->
                <TextBlock x:Name="RtssPingRow" Effect="{StaticResource OsdTextShadow}" Margin="0,1" FontFamily="Consolas, Segoe UI">
                    <Run Text="NET" FontWeight="Bold" Foreground="#CBD5E1" />
                    <Run Text=" : " Foreground="#64748B" />
                    <Run x:Name="RtssPingVal" Text="-- ms" FontWeight="Bold" Foreground="#F59E0B" />
                </TextBlock>

                <!-- Timer / Clock Row -->
                <TextBlock x:Name="RtssTimerRow" Effect="{StaticResource OsdTextShadow}" Margin="0,1" FontFamily="Consolas, Segoe UI">
                    <Run Text="TIME" FontWeight="Bold" Foreground="#CBD5E1" />
                    <Run Text=": " Foreground="#64748B" />
                    <Run x:Name="RtssTimerVal" Text="00:00:00" FontWeight="Bold" Foreground="#E2E8F0" />
                </TextBlock>
            </StackPanel>

            <!-- ============================================================== -->
            <!-- STYLE 1: GLASSMORPHIC CARD (ORIGINAL RICH CARD WITH BARS)      -->
            <!-- ============================================================== -->
            <StackPanel x:Name="PanelGlassmorphicCard" Visibility="Collapsed" Margin="0,2,0,4">
                <!-- CPU Metric -->
                <Grid x:Name="RowCardCpu" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="CPU" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Width="38" />
                    <ProgressBar x:Name="PbCpu" Grid.Column="1" Value="0" Maximum="100" Style="{StaticResource MiniMetricBar}" Foreground="#10B981" Margin="6,0,8,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCpuVal" Text="--%" FontSize="11" FontWeight="Bold" Foreground="#10B981" />
                        <TextBlock x:Name="TxtCpuTemp" Text="--°C" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="6,0,0,0" />
                    </StackPanel>
                </Grid>

                <!-- RAM Metric -->
                <Grid x:Name="RowCardRam" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="RAM" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Width="38" />
                    <ProgressBar x:Name="PbRam" Grid.Column="1" Value="0" Maximum="100" Style="{StaticResource MiniMetricBar}" Foreground="#38BDF8" Margin="6,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtRamVal" Grid.Column="2" Text="-- GB" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                </Grid>

                <!-- GPU Metric -->
                <Grid x:Name="RowCardGpu" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="GPU" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Width="38" />
                    <ProgressBar x:Name="PbGpu" Grid.Column="1" Value="0" Maximum="100" Style="{StaticResource MiniMetricBar}" Foreground="#A855F7" Margin="6,0,8,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtGpuVal" Text="Activa" FontSize="11" FontWeight="Bold" Foreground="#A855F7" />
                        <TextBlock x:Name="TxtGpuTemp" Text="--°C" FontSize="10" FontWeight="SemiBold" Foreground="#64748B" Margin="6,0,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Thermal Alert Banner -->
                <Border x:Name="BannerThermalAlert" Visibility="Collapsed" Background="#50EF4444" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,0,4">
                    <TextBlock x:Name="TxtThermalAlertMsg" Text="⚠️ ALERTA TÉRMICA: CPU > 85°C" FontSize="9.5" FontWeight="Bold" Foreground="#FCA5A5" HorizontalAlignment="Center" />
                </Border>

                <!-- Network & Latency (Ping) -->
                <Grid x:Name="RowCardPing" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="PING" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Width="38" />
                    <TextBlock x:Name="TxtPingStatus" Grid.Column="1" Text="Gateway" FontSize="10" Foreground="#64748B" Margin="6,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TxtPingVal" Grid.Column="2" Text="-- ms" FontSize="11" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" />
                </Grid>

                <!-- Bottom Session Timer & System Time Bar -->
                <Border x:Name="RowCardFooter" Background="#060913" CornerRadius="5" Padding="8,4" Margin="0,4,0,0" BorderBrush="#1E293B" BorderThickness="1">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="⏱️ Sesión: " FontSize="10" Foreground="#64748B" />
                            <TextBlock x:Name="TxtSessionTimer" Text="00:00:00" FontSize="10" FontWeight="SemiBold" Foreground="#F59E0B" Margin="0,0,12,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="🕒 " FontSize="10" Foreground="#64748B" />
                            <TextBlock x:Name="TxtClockTime" Text="--:--" FontSize="10" FontWeight="SemiBold" Foreground="#E2E8F0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ============================================================== -->
            <!-- STYLE 2: COMPACT HORIZONTAL BAR (SINGLE LINE)                  -->
            <!-- ============================================================== -->
            <StackPanel x:Name="PanelCompactBar" Visibility="Collapsed" Orientation="Horizontal" Margin="0,2,0,2">
                <TextBlock x:Name="CompactCpuBlock" Effect="{StaticResource OsdTextShadow}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0">
                    <Run Text="CPU: " Foreground="#94A3B8" /><Run x:Name="CompactCpu" Text="--%" Foreground="#10B981" FontWeight="Bold" /><Run x:Name="CompactCpuTemp" Text=" --°C" Foreground="#38BDF8" />
                </TextBlock>
                <TextBlock x:Name="CompactGpuBlock" Effect="{StaticResource OsdTextShadow}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0">
                    <Run Text="GPU: " Foreground="#94A3B8" /><Run x:Name="CompactGpu" Text="--%" Foreground="#A855F7" FontWeight="Bold" /><Run x:Name="CompactGpuTemp" Text=" --°C" Foreground="#38BDF8" />
                </TextBlock>
                <TextBlock x:Name="CompactRamBlock" Effect="{StaticResource OsdTextShadow}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0">
                    <Run Text="RAM: " Foreground="#94A3B8" /><Run x:Name="CompactRam" Text="-- GB" Foreground="#38BDF8" FontWeight="Bold" />
                </TextBlock>
                <TextBlock x:Name="CompactPingBlock" Effect="{StaticResource OsdTextShadow}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Margin="0,0,8,0">
                    <Run Text="PING: " Foreground="#94A3B8" /><Run x:Name="CompactPing" Text="-- ms" Foreground="#F59E0B" FontWeight="Bold" />
                </TextBlock>
                <TextBlock x:Name="CompactTimeBlock" Effect="{StaticResource OsdTextShadow}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold">
                    <Run x:Name="CompactTime" Text="00:00" Foreground="#CBD5E1" />
                </TextBlock>
            </StackPanel>

            <!-- ============================================================== -->
            <!-- COLLAPSIBLE SETTINGS DRAWER                                    -->
            <!-- ============================================================== -->
            <Border x:Name="DrawerSettings" Visibility="Collapsed" Background="#0C1322" BorderBrush="#1E2D4A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,8,0,0">
                <StackPanel Width="280">
                    <TextBlock Text="CONFIGURACIÓN DEL HUD" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8" />

                    <!-- Style Selector -->
                    <TextBlock Text="ESTILO VISUAL" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnStyleRiva" Content="Riva (Texto)" Click="BtnStyle_Click" Tag="0" Background="#1E293B" Foreground="#38BDF8" BorderThickness="0" Padding="6,4" FontSize="10" Margin="0,0,3,0" Cursor="Hand" />
                        <Button x:Name="BtnStyleCard" Grid.Column="1" Content="Tarjeta" Click="BtnStyle_Click" Tag="1" Background="{DynamicResource CardDarkHover}" Foreground="#94A3B8" BorderThickness="0" Padding="6,4" FontSize="10" Margin="2,0,2,0" Cursor="Hand" />
                        <Button x:Name="BtnStyleCompact" Grid.Column="2" Content="Barra" Click="BtnStyle_Click" Tag="2" Background="{DynamicResource CardDarkHover}" Foreground="#94A3B8" BorderThickness="0" Padding="6,4" FontSize="10" Margin="3,0,0,0" Cursor="Hand" />
                    </Grid>

                    <!-- Opacity Slider -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="TRANSPARENCIA FONDO" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" />
                        <TextBlock x:Name="TxtOpacityVal" Grid.Column="1" Text="0% (Puro)" FontSize="9.5" Foreground="#38BDF8" FontWeight="SemiBold" />
                    </Grid>
                    <Slider x:Name="SliderBgOpacity" Minimum="0" Maximum="1" Value="0" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="SliderBgOpacity_ValueChanged" Margin="0,0,0,10" />

                    <!-- Scale Slider -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="TAMAÑO / ESCALA" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" />
                        <TextBlock x:Name="TxtScaleVal" Grid.Column="1" Text="100%" FontSize="9.5" Foreground="#38BDF8" FontWeight="SemiBold" />
                    </Grid>
                    <Slider x:Name="SliderScale" Minimum="0.8" Maximum="1.6" Value="1.0" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="SliderScale_ValueChanged" Margin="0,0,0,10" />

                    <!-- Metric Checkboxes -->
                    <TextBlock Text="MÉTRICAS ACTIVAS" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6" />
                    <WrapPanel Margin="0,0,0,8">
                        <CheckBox x:Name="ChkCpu" Content="CPU" IsChecked="True" Checked="ChkMetric_Changed" Unchecked="ChkMetric_Changed" Foreground="#E2E8F0" FontSize="10" Margin="0,0,10,4" />
                        <CheckBox x:Name="ChkCpuTemp" Content="Temp CPU" IsChecked="True" Checked="ChkMetric_Changed" Unchecked="ChkMetric_Changed" Foreground="#E2E8F0" FontSize="10" Margin="0,0,10,4" />
                        <CheckBox x:Name="ChkGpu" Content="GPU" IsChecked="True" Checked="ChkMetric_Changed" Unchecked="ChkMetric_Changed" Foreground="#E2E8F0" FontSize="10" Margin="0,0,10,4" />
                        <CheckBox x:Name="ChkGpuTemp" Content="Temp GPU" IsChecked="True" Checked="ChkMetric_Changed" Unchecked="ChkMetric_Changed" Foreground="#E2E8F0" FontSize="10" Margin="0,0,10,4" />
                        <CheckBox x:Name="ChkRam" Content="RAM" IsChecked="True" Checked="ChkMetric_Changed" Unchecked="ChkMetric_Changed" Foreground="#E2E8F0" FontSize="10" Margin="0,0,10,4" />
                        <CheckBox x:Name="ChkPing" Content="Red / Ping" IsChecked="True" Checked="ChkMetric_Changed" Unchecked="ChkMetric_Changed" Foreground="#E2E8F0" FontSize="10" Margin="0,0,10,4" />
                        <CheckBox x:Name="ChkTimer" Content="Sesión / Hora" IsChecked="True" Checked="ChkMetric_Changed" Unchecked="ChkMetric_Changed" Foreground="#E2E8F0" FontSize="10" Margin="0,0,10,4" />
                    </WrapPanel>

                    <!-- Quick Corner Placement -->
                    <TextBlock Text="POSICIÓN RÁPIDA EN PANTALLA" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="↖ Sup.Izq" Click="BtnCorner_Click" Tag="TL" Background="#1E293B" Foreground="#E2E8F0" BorderThickness="0" Padding="4,3" FontSize="9" Margin="0,0,2,0" Cursor="Hand" />
                        <Button Grid.Column="1" Content="↗ Sup.Der" Click="BtnCorner_Click" Tag="TR" Background="#1E293B" Foreground="#E2E8F0" BorderThickness="0" Padding="4,3" FontSize="9" Margin="2,0,2,0" Cursor="Hand" />
                        <Button Grid.Column="2" Content="↙ Inf.Izq" Click="BtnCorner_Click" Tag="BL" Background="#1E293B" Foreground="#E2E8F0" BorderThickness="0" Padding="4,3" FontSize="9" Margin="2,0,2,0" Cursor="Hand" />
                        <Button Grid.Column="3" Content="↘ Inf.Der" Click="BtnCorner_Click" Tag="BR" Background="#1E293B" Foreground="#E2E8F0" BorderThickness="0" Padding="4,3" FontSize="9" Margin="2,0,0,0" Cursor="Hand" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
