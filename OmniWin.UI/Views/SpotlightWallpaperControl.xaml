<UserControl x:Class="OmniWin.UI.Views.SpotlightWallpaperControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1000"
             Foreground="{DynamicResource TextPrimary}"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
             Loaded="UserControl_Loaded">

    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Wallpapers List -->
            <RowDefinition Height="*" />
            <!-- Status Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header & Actions -->
        <Border Grid.Row="0" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Background="#1E1B4B" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                            <TextBlock x:Name="TxtWallpaperCountBadge" Text="0 FONDOS 4K" FontSize="11" FontWeight="Bold" Foreground="#818CF8" />
                        </Border>
                        <TextBlock Text="Extractor de Fondos 4K de Windows Spotlight &amp; Bing" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                    </StackPanel>
                    <TextBlock Text="Descubre y rescata las impresionantes fotografías ultra-HD que Windows descarga automáticamente para la pantalla de bloqueo." FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔄 Actualizar" Click="BtnRefresh_Click" Style="{DynamicResource SecondaryButton}" Padding="12,6" FontSize="12" Margin="0,0,8,0" />
                    <Button x:Name="BtnExportAll" Content="📥 Exportar Todos a Imágenes" Click="BtnExportAll_Click" Style="{DynamicResource PrimaryButton}" Padding="14,6" FontSize="12" FontWeight="Bold" Margin="0,0,8,0" />
                    <Button Content="📁 Abrir Carpeta de Exportación" Click="BtnOpenExportFolder_Click" Style="{DynamicResource SecondaryButton}" Padding="12,6" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Wallpapers DataGrid -->
        <Border Grid.Row="1" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="FOTOGRAFÍAS ULTRA-HD IDENTIFICADAS EN LA CACHÉ LOCAL" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtAssetDirHint" Text="Caché de ContentDeliveryManager" FontSize="11" Foreground="{DynamicResource TextSecondary}" Grid.Column="1" VerticalAlignment="Center" />
                </Grid>

                <DataGrid Grid.Row="1" x:Name="DgWallpapers" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0" GridLinesVisibility="None" HeadersVisibility="Column"
                          Foreground="{DynamicResource TextPrimary}" RowBackground="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Resolución" Binding="{Binding Resolution}" Width="120" />
                        <DataGridTextColumn Header="Tamaño" Binding="{Binding SizeText}" Width="110" />
                        <DataGridTextColumn Header="Fecha de Descarga" Binding="{Binding DateText}" Width="140" />
                        <DataGridTextColumn Header="Identificador de Archivo" Binding="{Binding FileName}" Width="*" />
                        <DataGridTemplateColumn Header="Acciones" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🖼️ Poner de Fondo" Click="BtnSetWallpaper_Click" Tag="{Binding OriginalFilePath}" Background="#059669" Foreground="White" Padding="10,4" FontSize="11.5" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Status Footer -->
        <TextBlock Grid.Row="2" x:Name="TxtStatus" Text="Listo." FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="2,8,0,0" />
    </Grid>
</UserControl>
