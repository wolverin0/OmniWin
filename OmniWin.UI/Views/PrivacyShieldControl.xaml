<UserControl x:Class="OmniWin.UI.Views.PrivacyShieldControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1000"
             Foreground="{DynamicResource TextPrimary}"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
             Loaded="UserControl_Loaded">

    <Grid Margin="0,12,0,0">
        <TabControl>

            <!-- ========================================================= -->
            <!-- TAB 1: PRIVACIDAD & ANTI-TELEMETRÍA (SHUTUP10 STYLE)      -->
            <!-- ========================================================= -->
            <TabItem Header="🛡️ Privacidad &amp; Anti-Telemetría">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Profile Quick Bar -->
                    <Border Grid.Row="0" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Background="#064E3B" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                                        <TextBlock x:Name="TxtProtectedBadge" Text="0/0 PROTEGIDOS" FontSize="11" FontWeight="Bold" Foreground="#34D399" />
                                    </Border>
                                    <TextBlock Text="Centro de Privacidad Transaccional de Windows 11 &amp; 10" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                </StackPanel>
                                <TextBlock Text="Desactiva telemetría, capturas de Windows Recall, búsquedas Bing en el inicio y recopilación de datos con rollback seguro garantizado." FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnProfileRecommended" Content="🟢 Recomendado" Click="BtnProfileRecommended_Click" Background="#065F46" Foreground="White" Margin="0,0,8,0" Padding="12,6" FontSize="11.5" ToolTip="Máxima privacidad sin romper Store, Xbox ni updates" />
                                <Button x:Name="BtnProfileStrict" Content="🟡 Privacidad Máxima" Click="BtnProfileStrict_Click" Background="#854D0E" Foreground="White" Margin="0,0,8,0" Padding="12,6" FontSize="11.5" />
                                <Button x:Name="BtnProfileGamer" Content="🎮 Modo Gamer" Click="BtnProfileGamer_Click" Background="#1E40AF" Foreground="White" Margin="0,0,8,0" Padding="12,6" FontSize="11.5" />
                                <Button x:Name="BtnRefreshAudit" Content="🔄 Actualizar" Click="BtnRefreshAudit_Click" Style="{DynamicResource SecondaryButton}" Padding="10,6" FontSize="11.5" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Settings List -->
                    <Border Grid.Row="1" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <DataGrid x:Name="DgPrivacySettings" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="Transparent" BorderThickness="0" GridLinesVisibility="None" HeadersVisibility="Column"
                                  Foreground="{DynamicResource TextPrimary}" RowBackground="Transparent">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Protección" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StatusBackground}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding IsProtectedText}" FontWeight="Bold" FontSize="11" Foreground="{Binding StatusColor}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Categoría" Binding="{Binding CategoryName}" Width="160" />
                                <DataGridTextColumn Header="Ajuste de Privacidad" Binding="{Binding Title}" Width="280" />
                                <DataGridTextColumn Header="Seguridad" Binding="{Binding SafetyLevel}" Width="100" />
                                <DataGridTextColumn Header="Detalle / Qué hace" Binding="{Binding Description}" Width="*" />

                                <DataGridTemplateColumn Header="Acción" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding ActionButtonText}" Click="BtnToggleSetting_Click" Tag="{Binding Id}"
                                                    Background="{Binding ActionButtonBackground}" Foreground="White" FontSize="10.5" Padding="8,3" BorderThickness="0" Cursor="Hand" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Footer Status -->
                    <Border Grid.Row="2" Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0">
                        <TextBlock x:Name="TxtPrivacyFooterStatus" Text="Auditoría de privacidad completada. Las mutaciones están respaldadas con WAL transaccional." FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================================= -->
            <!-- TAB 2: TRAMPAS CANARIO ANTI-RANSOMWARE (HONEYPOT SHIELD)   -->
            <!-- ========================================================= -->
            <TabItem Header="🪤 Trampas Canario Anti-Ransomware">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Canary Hero -->
                    <Border Grid.Row="0" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Background="#1C1917" BorderBrush="#78350F" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                                        <TextBlock x:Name="TxtCanaryStatusBadge" Text="ESCUDO INACTIVO" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" />
                                    </Border>
                                    <TextBlock Text="Defensa Activa Anti-Ransomware con Trampas Señuelo" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                </StackPanel>
                                <TextBlock Text="Siembra archivos señuelo en carpetas críticas. Si un virus o ransomware intenta tocarlos o cifrarlos, OmniWin congela el proceso culpable inmediatamente con NtSuspendProcess." FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnToggleCanaryShield" Content="🛡️ Activar Escudo Canario" Click="BtnToggleCanaryShield_Click" Background="#10B981" Foreground="White" Padding="14,6" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Canary Alerts & Traps Grid -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Active Canaries & Protected Folders -->
                        <Border Grid.Column="0" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="CARPETAS VIGILADAS Y TRAMPAS ACTIVAS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" />
                                <ListBox x:Name="LbCanaryFiles" Background="Transparent" BorderThickness="0" MaxHeight="380">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <TextBlock Text="🪤 Trampa Señuelo" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" />
                                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <!-- Right: Real-time Breaches & Security Log -->
                        <Border Grid.Column="2" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="ALERTAS DE ATAQUES BLOQUEADOS / PROCESOS CONGELADOS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" />

                                <ListBox Grid.Row="1" x:Name="LbBreachAlerts" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1F1315" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="🚨" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="¡AMENAZA FRENADA! " FontWeight="Bold" Foreground="#F87171" FontSize="12" />
                                                            <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss'}" Foreground="{DynamicResource TextSecondary}" FontSize="11" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding ActionTaken}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,2" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding OffendingProcessPath, StringFormat='Ruta binario: {0}'}" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Canary Footer -->
                    <Border Grid.Row="2" Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0">
                        <TextBlock x:Name="TxtCanaryFooterStatus" Text="Escudo canario listo para defender documentos y fotos contra ataques de cifrado." FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
