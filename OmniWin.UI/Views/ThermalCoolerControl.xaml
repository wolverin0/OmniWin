<UserControl x:Class="OmniWin.UI.Views.ThermalCoolerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="950"
             Foreground="{DynamicResource TextPrimary}"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="TempNormalBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#10B981" Offset="0.0" />
            <GradientStop Color="#34D399" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TempWarningBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#F59E0B" Offset="0.0" />
            <GradientStop Color="#FBBF24" Offset="1.0" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TempCriticalBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#EF4444" Offset="0.0" />
            <GradientStop Color="#DC2626" Offset="1.0" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <Grid>
        <StackPanel Margin="0,4,0,16">

            <!-- 1. TOP OVERVIEW: LIVE TEMPERATURE CARDS & GLOBAL STATUS -->
            <Border Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border x:Name="BadgeThermalState" Background="#064E3B" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="DotThermalStatus" Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtThermalBadge" Text="NORMAL" FontSize="11" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Monitoreo Térmico &amp; Sensores Hardware" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Lectura profunda de sensores en silicio (CPU Package/Cores, GPU Hotspot, VRM y NVMe S.M.A.R.T.) vía LibreHardwareMonitor." FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>

                        <!-- Global Emergency Actions -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnRampFans100" Content="🌪️ Ventiladores al 100%" Click="BtnRampFans100_Click" Background="#DC2626" Foreground="White" Margin="0,0,8,0" Padding="12,6" FontSize="12" ToolTip="Fuerza máxima disipación de calor para enfriar el sistema" />
                            <Button x:Name="BtnRestoreAllFans" Content="🔄 Restaurar Auto (BIOS)" Click="BtnRestoreAllFans_Click" Style="{DynamicResource SecondaryButton}" Padding="12,6" FontSize="12" ToolTip="Restaura el control de ventiladores a la placa base o VBIOS" />
                        </StackPanel>
                    </Grid>

                    <!-- Three Primary Thermal Cards -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- CPU Card -->
                        <Border Grid.Column="0" Background="#0A0F1D" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="PROCESADOR (CPU)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="TxtCpuTripStatus" Text="Normal" FontSize="10" FontWeight="SemiBold" Foreground="#10B981" HorizontalAlignment="Right" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                    <TextBlock x:Name="TxtCpuTempBig" Text="--°C" FontSize="26" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtCpuModel" Text="CPU Package" FontSize="11" Foreground="#64748B" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <ProgressBar x:Name="PbCpuTemp" Value="0" Maximum="105" Height="6" Background="#1E293B" Foreground="#10B981" Margin="0,0,0,6" />
                                <TextBlock x:Name="TxtCpuThresholds" Text="Umbrales: Warn 80°C • Crit 90°C" FontSize="10.5" Foreground="#64748B" />
                            </StackPanel>
                        </Border>

                        <!-- GPU Card -->
                        <Border Grid.Column="1" Background="#0A0F1D" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="4,0,4,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="GRÁFICA (GPU)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="TxtGpuTripStatus" Text="Normal" FontSize="10" FontWeight="SemiBold" Foreground="#10B981" HorizontalAlignment="Right" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                    <TextBlock x:Name="TxtGpuTempBig" Text="--°C" FontSize="26" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtGpuModel" Text="GPU Core" FontSize="11" Foreground="#64748B" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <ProgressBar x:Name="PbGpuTemp" Value="0" Maximum="100" Height="6" Background="#1E293B" Foreground="#38BDF8" Margin="0,0,0,6" />
                                <TextBlock x:Name="TxtGpuThresholds" Text="Umbrales: Warn 75°C • Crit 85°C" FontSize="10.5" Foreground="#64748B" />
                            </StackPanel>
                        </Border>

                        <!-- Storage NVMe Card -->
                        <Border Grid.Column="2" Background="#0A0F1D" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="8,0,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="ALMACENAMIENTO NVMe" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="TxtStorageTripStatus" Text="Normal" FontSize="10" FontWeight="SemiBold" Foreground="#10B981" HorizontalAlignment="Right" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                    <TextBlock x:Name="TxtStorageTempBig" Text="--°C" FontSize="26" FontWeight="Bold" Foreground="#A855F7" VerticalAlignment="Center" />
                                    <TextBlock Text="Máx S.M.A.R.T." FontSize="11" Foreground="#64748B" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <ProgressBar x:Name="PbStorageTemp" Value="0" Maximum="85" Height="6" Background="#1E293B" Foreground="#A855F7" Margin="0,0,0,6" />
                                <TextBlock x:Name="TxtStorageThresholds" Text="Umbrales: Warn 60°C • Crit 70°C" FontSize="10.5" Foreground="#64748B" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Thermal Health & Paste Diagnostics Banner -->
                    <Border Grid.Row="2" Background="#090D18" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Background="#0B192C" CornerRadius="6" Padding="10,6" VerticalAlignment="Center" Margin="0,0,14,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="SALUD TÉRMICA" FontSize="9.5" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="TxtHealthScore" Text="100%" FontSize="20" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtHealthStatus" Text="Salud Térmica Óptima (Excelente Disipación)" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock x:Name="TxtHealthSummary" Text="No se detectan fugas térmicas, pasta seca ni estrangulamiento de frecuencias." FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                            </StackPanel>

                            <Border Grid.Column="2" Background="#1E293B" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtThermalResistance" Text="Resistencia: ~0.28 °C/W" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 2. COOLERS & FANS CONTROL PANEL -->
            <Border Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="🌪️ Control de Coolers &amp; Tacómetro de Ventiladores (RPM)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="Control de duty-cycle por software en cabezales Super I/O y control de ventiladores de GPU." FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="TxtFanSummaryCount" Text="Detectando ventiladores..." FontSize="11" Foreground="{DynamicResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Fan Curve Selector & Game Auto-Switch Bar -->
                    <Border Background="#090D18" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="Perfil de Curva:" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="CmbFanProfiles" SelectionChanged="CmbFanProfiles_SelectionChanged" Width="240" Padding="8,5" FontSize="11.5" Background="#0A0F1D" Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                <TextBlock x:Name="TxtCurveDescription" Text="Curva equilibrada con histéresis de 3°C contra picos cortos de temperatura." FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <CheckBox Grid.Column="2" x:Name="ChkAutoGameProfile" Content="🎮 Auto-Perfil Gamer al Jugar" IsChecked="True" Checked="ChkAutoGameProfile_Changed" Unchecked="ChkAutoGameProfile_Changed" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Fans ItemsControl -->
                    <ItemsControl x:Name="IcFans">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#090D18" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Fan Identity -->
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock Text="{Binding HardwareName}" FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- RPM Display -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Rpm}" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" />
                                                <TextBlock Text=" RPM" FontSize="11" Foreground="#64748B" VerticalAlignment="Bottom" Margin="2,0,0,1" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding ControlPercent, StringFormat='Potencia: {0}%'}" FontSize="10" Foreground="#94A3B8" />
                                        </StackPanel>

                                        <!-- Speed Slider (if controllable) -->
                                        <Grid Grid.Column="2" Margin="16,0,16,0" VerticalAlignment="Center">
                                            <Slider Minimum="0" Maximum="100" Value="{Binding ControlPercent, Mode=OneWay}" 
                                                    IsEnabled="{Binding CanControl}" ValueChanged="FanSlider_ValueChanged" Tag="{Binding ControlIdentifier}" 
                                                    SmallChange="5" LargeChange="10" TickFrequency="10" IsSnapToTickEnabled="False" />
                                        </Grid>

                                        <!-- Control Mode Button -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Auto BIOS" Click="BtnFanAuto_Click" Tag="{Binding ControlIdentifier}" Style="{DynamicResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,0" ToolTip="Restaurar a curva automática de placa base" />
                                            <Button Content="100%" Click="BtnFanMax_Click" Tag="{Binding ControlIdentifier}" Background="#B91C1C" Foreground="White" Padding="8,4" FontSize="11" ToolTip="Fijar este ventilador a máxima velocidad" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="BoxNoFansFound" Visibility="Collapsed" Background="#090D18" CornerRadius="6" Padding="16" Margin="0,4,0,0">
                        <TextBlock Text="ℹ️ No se detectaron cabezales de ventilador controlables por software directamente en este bus (típico en laptops o placas sin driver Ring-0). Los sensores de temperatura continúan 100% operativos." FontSize="11.5" Foreground="#94A3B8" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- 3. CONFIGURATION: THRESHOLDS & ALARMS -->
            <Border Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel>
                    <TextBlock Text="⚙️ Configuración de Umbrales Térmicos &amp; Protocolos de Alarma" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- CPU Threshold Sliders -->
                        <Border Grid.Column="0" Background="#090D18" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Umbrales de CPU" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                                <TextBlock x:Name="TxtCpuWarnLabel" Text="Advertencia: 80°C" FontSize="11" Foreground="#F59E0B" />
                                <Slider x:Name="SliderCpuWarn" Minimum="50" Maximum="95" Value="80" ValueChanged="SliderThreshold_ValueChanged" Margin="0,4,0,8" />

                                <TextBlock x:Name="TxtCpuCritLabel" Text="Crítico / Emergencia: 90°C" FontSize="11" Foreground="#EF4444" />
                                <Slider x:Name="SliderCpuCrit" Minimum="70" Maximum="105" Value="90" ValueChanged="SliderThreshold_ValueChanged" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- GPU Threshold Sliders -->
                        <Border Grid.Column="1" Background="#090D18" CornerRadius="6" Padding="12" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="Umbrales de GPU" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                                <TextBlock x:Name="TxtGpuWarnLabel" Text="Advertencia: 75°C" FontSize="11" Foreground="#F59E0B" />
                                <Slider x:Name="SliderGpuWarn" Minimum="50" Maximum="90" Value="75" ValueChanged="SliderThreshold_ValueChanged" Margin="0,4,0,8" />

                                <TextBlock x:Name="TxtGpuCritLabel" Text="Crítico / Emergencia: 85°C" FontSize="11" Foreground="#EF4444" />
                                <Slider x:Name="SliderGpuCrit" Minimum="65" Maximum="100" Value="85" ValueChanged="SliderThreshold_ValueChanged" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Storage Threshold Sliders -->
                        <Border Grid.Column="2" Background="#090D18" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Umbrales NVMe / SSD" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                                <TextBlock x:Name="TxtStorageWarnLabel" Text="Advertencia: 60°C" FontSize="11" Foreground="#F59E0B" />
                                <Slider x:Name="SliderStorageWarn" Minimum="40" Maximum="75" Value="60" ValueChanged="SliderThreshold_ValueChanged" Margin="0,4,0,8" />

                                <TextBlock x:Name="TxtStorageCritLabel" Text="Crítico / Throttling: 70°C" FontSize="11" Foreground="#EF4444" />
                                <Slider x:Name="SliderStorageCrit" Minimum="55" Maximum="85" Value="70" ValueChanged="SliderThreshold_ValueChanged" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Alarms Behavior Toggles -->
                    <Border Background="#090D18" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkAudioAlarm" Content="🔊 Alarma Sonora de Advertencia" IsChecked="False" Checked="AlarmOption_Changed" Unchecked="AlarmOption_Changed" Margin="0,0,24,0" Foreground="{DynamicResource TextPrimary}" />
                            <CheckBox x:Name="ChkOverlayBanner" Content="🎮 Alerta en HUD de Juego (Overlay)" IsChecked="True" Checked="AlarmOption_Changed" Unchecked="AlarmOption_Changed" Margin="0,0,24,0" Foreground="{DynamicResource TextPrimary}" />
                            <CheckBox x:Name="ChkEmergencyCooling" Content="🌪️ Purgar Calor al 100% en Estado Crítico" IsChecked="False" Checked="AlarmOption_Changed" Unchecked="AlarmOption_Changed" Margin="0,0,24,0" Foreground="{DynamicResource TextPrimary}" />
                            <CheckBox x:Name="ChkEmergencyPowerMitigate" Content="🛡️ Mitigación de Energía (Power Saver temporal si es crítico)" IsChecked="False" Checked="AlarmOption_Changed" Unchecked="AlarmOption_Changed" Foreground="{DynamicResource TextPrimary}" />
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</UserControl>
