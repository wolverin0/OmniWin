<UserControl x:Class="OmniWin.UI.Views.SoftwareDriversControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1000"
             Foreground="{DynamicResource TextPrimary}"
             FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
             Loaded="UserControl_Loaded">

    <Grid>
        <TabControl>

            <!-- ========================================================= -->
            <!-- TAB 1: ACTUALIZADOR DE SOFTWARE & APP STORE               -->
            <!-- ========================================================= -->
            <TabItem Header="📦 Actualizador de Programas &amp; Tienda">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <!-- Top Action Bar -->
                        <Border Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,10,0">
                                            <TextBlock x:Name="TxtUpgradesBadge" Text="0 ACTUALIZACIONES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Emerald}" />
                                        </Border>
                                        <TextBlock Text="Actualizador Universal de Software (WinGet &amp; MS Store)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                    </StackPanel>
                                    <TextBlock Text="Mantiene todas tus aplicaciones actualizadas a la última versión en un solo clic, sin anuncios ni instaladores molestos." FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnCheckUpdates" Content="🔄 Buscar Actualizaciones" Click="BtnCheckUpdates_Click" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0" Padding="12,6" FontSize="12" />
                                    <Button x:Name="BtnUpgradeAll" Content="🚀 Actualizar Todo en 1 Clic" Click="BtnUpgradeAll_Click" Style="{DynamicResource PrimaryButton}" Padding="14,6" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Updates DataGrid -->
                        <Border Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="PROGRAMAS CON NUEVAS VERSIONES DISPONIBLES" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10" />

                                <DataGrid x:Name="DgUpgrades" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220"
                                          Background="Transparent" BorderThickness="0" GridLinesVisibility="None" HeadersVisibility="Column"
                                          Foreground="{DynamicResource TextPrimary}" RowBackground="Transparent">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Aplicación" Binding="{Binding Name}" Width="260" />
                                        <DataGridTextColumn Header="ID WinGet" Binding="{Binding Id}" Width="200" />
                                        <DataGridTextColumn Header="Versión Actual" Binding="{Binding InstalledVersion}" Width="140" />
                                        <DataGridTextColumn Header="Nueva Versión" Binding="{Binding AvailableVersion}" Width="140" />
                                        <DataGridTemplateColumn Header="Acción" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Actualizar" Click="BtnUpgradeSingle_Click" Padding="8,3" FontSize="11" Style="{DynamicResource SecondaryButton}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock x:Name="TxtNoUpgrades" Text="✔ Todos los programas compatibles con WinGet están actualizados." FontSize="12" Foreground="{DynamicResource Emerald}" Visibility="Collapsed" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Quick App Store (Ninite Style) -->
                        <Border Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="⚡ Instalador Masivo de Software Esencial (Estilo Ninite)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="Selecciona las aplicaciones que deseas instalar y OmniWin las descargará e instalará automáticamente sin interacción." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button x:Name="BtnInstallSelectedApps" Content="📥 Instalar Apps Seleccionadas" Click="BtnInstallSelectedApps_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource PrimaryButton}" Padding="14,6" FontSize="12" />
                                </Grid>

                                <WrapPanel x:Name="WpEssentialApps" Orientation="Horizontal">
                                    <CheckBox x:Name="AppChrome" Content="Google Chrome" Tag="Google.Chrome" Margin="0,0,18,10" Foreground="{DynamicResource TextPrimary}" />
                                    <CheckBox x:Name="AppFirefox" Content="Mozilla Firefox" Tag="Mozilla.Firefox" Margin="0,0,18,10" Foreground="{DynamicResource TextPrimary}" />
                                    <CheckBox x:Name="App7Zip" Content="7-Zip" Tag="7zip.7zip" Margin="0,0,18,10" Foreground="{DynamicResource TextPrimary}" />
                                    <CheckBox x:Name="AppVSCode" Content="Visual Studio Code" Tag="Microsoft.VisualStudioCode" Margin="0,0,18,10" Foreground="{DynamicResource TextPrimary}" />
                                    <CheckBox x:Name="AppGit" Content="Git" Tag="Git.Git" Margin="0,0,18,10" Foreground="{DynamicResource TextPrimary}" />
                                    <CheckBox x:Name="AppDiscord" Content="Discord" Tag="Discord.Discord" Margin="0,0,18,10" Foreground="{DynamicResource TextPrimary}" />
                                    <CheckBox x:Name="AppVlc" Content="VLC Media Player" Tag="VideoLAN.VLC" Margin="0,0,18,10" Foreground="{DynamicResource TextPrimary}" />
                                    <CheckBox x:Name="AppSteam" Content="Steam" Tag="Valve.Steam" Margin="0,0,18,10" Foreground="{DynamicResource TextPrimary}" />
                                    <CheckBox x:Name="AppObsidian" Content="Obsidian" Tag="Obsidian.Obsidian" Margin="0,0,18,10" Foreground="{DynamicResource TextPrimary}" />
                                    <CheckBox x:Name="AppPowerToys" Content="Microsoft PowerToys" Tag="Microsoft.PowerToys" Margin="0,0,18,10" Foreground="{DynamicResource TextPrimary}" />
                                    <CheckBox x:Name="AppNotepadPlus" Content="Notepad++" Tag="Notepad++.Notepad++" Margin="0,0,18,10" Foreground="{DynamicResource TextPrimary}" />
                                    <CheckBox x:Name="AppEverything" Content="Voidtools Everything" Tag="voidtools.Everything" Margin="0,0,18,10" Foreground="{DynamicResource TextPrimary}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Live Streaming Console Output -->
                        <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel>
                                <TextBlock Text="TERMINAL DE INSTALACIÓN WINGET" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                                <TextBox x:Name="TxtConsoleOutput" Text="Listo para actualizar o instalar software." IsReadOnly="True" Background="Transparent" Foreground="{DynamicResource TextPrimary}" FontFamily="Consolas" FontSize="11.5" BorderThickness="0" TextWrapping="Wrap" MaxHeight="140" VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========================================================= -->
            <!-- TAB 2: GESTOR Y LIMPIADOR DE DRIVERS (DRIVERSTORE)        -->
            <!-- ========================================================= -->
            <TabItem Header="🚗 Controladores (DriverStore)">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Almacén de Controladores OEM (C:\Windows\System32\DriverStore)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="Visualiza y elimina controladores viejos o duplicados de GPU, audio y red acumulados en tu sistema para recuperar gigabytes." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="TxtDriverSearch" Width="160" Padding="8,5" Margin="0,0,6,0" TextChanged="TxtDriverSearch_TextChanged" ToolTip="Buscar por proveedor o nombre..." />
                                <Button x:Name="BtnRefreshDrivers" Content="🔄 Actualizar" Click="BtnRefreshDrivers_Click" Style="{DynamicResource SecondaryButton}" Margin="0,0,6,0" Padding="10,6" FontSize="11" />
                                <Button x:Name="BtnExportDrivers" Content="💾 Backup Drivers" Click="BtnExportDrivers_Click" Style="{DynamicResource SecondaryButton}" Margin="0,0,6,0" Padding="10,6" FontSize="11" ToolTip="Exporta todos los controladores OEM a una carpeta (C:\OmniWin_DriverBackup)" />
                                <Button x:Name="BtnRestoreDrivers" Content="📥 Restaurar" Click="BtnRestoreDrivers_Click" Style="{DynamicResource SecondaryButton}" Margin="0,0,6,0" Padding="10,6" FontSize="11" ToolTip="Instala controladores desde una carpeta de respaldo" />
                                <Button x:Name="BtnDeleteSelectedDriver" Content="🗑️ Eliminar" Click="BtnDeleteSelectedDriver_Click" Style="{DynamicResource DestructiveButton}" Padding="10,6" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <DataGrid x:Name="DgDrivers" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="Transparent" BorderThickness="0" GridLinesVisibility="None" HeadersVisibility="Column"
                                  Foreground="{DynamicResource TextPrimary}" RowBackground="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Archivo INF" Binding="{Binding PublishedName}" Width="110" />
                                <DataGridTextColumn Header="Nombre Original" Binding="{Binding OriginalName}" Width="160" />
                                <DataGridTextColumn Header="Proveedor" Binding="{Binding Provider}" Width="150" />
                                <DataGridTextColumn Header="Clase" Binding="{Binding ClassName}" Width="120" />
                                <DataGridTextColumn Header="Versión y Fecha" Binding="{Binding DateAndVersion}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Row="2" Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0">
                        <TextBlock x:Name="TxtDriverStatus" Text="Cargando controladores del DriverStore..." FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================================= -->
            <!-- TAB 3: DESINSTALADOR PROFUNDO & RASTROS                   -->
            <!-- ========================================================= -->
            <TabItem Header="🧹 Desinstalador Profundo &amp; Sobras">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Desinstalador con Limpieza de Rastros (Estilo Revo Uninstaller)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="Desinstala programas de escritorio y escanea carpetas huérfanas en AppData, ProgramData y claves residuales del Registro." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="TxtAppSearch" Width="200" Padding="8,5" Margin="0,0,8,0" TextChanged="TxtAppSearch_TextChanged" ToolTip="Buscar programa..." />
                                <Button x:Name="BtnRefreshApps" Content="🔄 Actualizar" Click="BtnRefreshApps_Click" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0" Padding="12,6" FontSize="12" />
                                <Button x:Name="BtnUninstallApp" Content="Desinstalar" Click="BtnUninstallApp_Click" Style="{DynamicResource DestructiveButton}" Margin="0,0,8,0" Padding="12,6" FontSize="12" />
                                <Button x:Name="BtnScanLeftovers" Content="🔍 Escanear Rastros" Click="BtnScanLeftovers_Click" Style="{DynamicResource SecondaryButton}" Padding="12,6" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <DataGrid x:Name="DgInstalledApps" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="Transparent" BorderThickness="0" GridLinesVisibility="None" HeadersVisibility="Column"
                                  Foreground="{DynamicResource TextPrimary}" RowBackground="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nombre de Aplicación" Binding="{Binding DisplayName}" Width="300" />
                                <DataGridTextColumn Header="Versión" Binding="{Binding DisplayVersion}" Width="120" />
                                <DataGridTextColumn Header="Editor / Fabricante" Binding="{Binding Publisher}" Width="200" />
                                <DataGridTextColumn Header="Tamaño Estimado" Binding="{Binding EstimatedSizeMb, StringFormat='{}{0:F1} MB'}" Width="120" />
                                <DataGridTextColumn Header="Fecha Instalación" Binding="{Binding InstallDate}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Row="2" Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,12,0,0">
                        <TextBlock x:Name="TxtUninstallStatus" Text="Selecciona un programa para desinstalar o analizar sobras." FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================================= -->
            <!-- TAB 4: BIOS, PLACA MADRE & RAM                            -->
            <!-- ========================================================= -->
            <TabItem Header="🧬 Placa Madre, BIOS &amp; RAM">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <!-- Motherboard & BIOS Card -->
                        <Border Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,16">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Placa Madre (Motherboard) &amp; BIOS" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock Text="Identificación de chipset, versión de firmware UEFI y estado del módulo de plataforma de confianza TPM." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Content="🔄 Re-leer WMI" Click="BtnRefreshBios_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{DynamicResource SecondaryButton}" Padding="12,6" FontSize="12" />
                                </Grid>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Motherboard Column -->
                                    <Border Grid.Column="0" Background="{DynamicResource CardDarkHover}" CornerRadius="6" Padding="14" Margin="0,0,8,0" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="PLACA BASE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8" />
                                            <TextBlock x:Name="TxtMbProduct" Text="Cargando..." FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                                            <TextBlock x:Name="TxtMbManufacturer" Text="Fabricante: --" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2" />
                                            <TextBlock x:Name="TxtMbVersion" Text="Versión: --" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- BIOS Column -->
                                    <Border Grid.Column="1" Background="{DynamicResource CardDarkHover}" CornerRadius="6" Padding="14" Margin="8,0,0,0" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="BIOS / FIRMWARE UEFI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8" />
                                            <TextBlock x:Name="TxtBiosVersion" Text="Cargando..." FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Emerald}" Margin="0,0,0,4" />
                                            <TextBlock x:Name="TxtBiosVendor" Text="Fabricante: --" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2" />
                                            <TextBlock x:Name="TxtBiosDate" Text="Fecha: --" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />

                                            <WrapPanel Orientation="Horizontal">
                                                <Border x:Name="BadgeSecureBoot" Background="{DynamicResource CardBorderSubtle}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock x:Name="TxtSecureBootStatus" Text="Secure Boot: Activo ✔" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Emerald}" />
                                                </Border>
                                                <Border x:Name="BadgeTpm" Background="{DynamicResource CardBorderSubtle}" CornerRadius="4" Padding="6,2">
                                                    <TextBlock x:Name="TxtTpmStatus" Text="TPM 2.0: Habilitado ✔" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Emerald}" />
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- RAM Configuration Card -->
                        <Border Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Módulos de Memoria RAM Física &amp; Frecuencias" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock x:Name="TxtRamTopologySummary" Text="Detectando topología de memoria..." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Background="{DynamicResource CardBorderSubtle}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtRamTotalHeader" Text="Total: -- GB" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                    </Border>
                                </Grid>

                                <ItemsControl x:Name="IcRamModules">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="180" />
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DeviceLocator}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" />
                                                        <TextBlock Text="Ranura DIMM" FontSize="10.5" Foreground="{DynamicResource TextMuted}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Manufacturer}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimary}" />
                                                        <TextBlock Text="Fabricante de Módulo" FontSize="10.5" Foreground="{DynamicResource TextMuted}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CapacityGb, StringFormat='{}{0:F0} GB'}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Emerald}" />
                                                        <TextBlock Text="Capacidad" FontSize="10.5" Foreground="{DynamicResource TextMuted}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SpeedMtS, StringFormat='{}{0} MT/s'}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Amber}" />
                                                        <TextBlock Text="Velocidad Reloj" FontSize="10.5" Foreground="{DynamicResource TextMuted}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding PartNumber}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" />
                                                        <TextBlock Text="Número de Parte (XMP/EXPO)" FontSize="10.5" Foreground="{DynamicResource TextMuted}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
