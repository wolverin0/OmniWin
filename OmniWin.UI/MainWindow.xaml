                            <TextBlock Text="Desbloqueador de Archivos (Restart Manager)" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="¿Un archivo no se puede borrar o editar porque está abierto en otro proceso? Identifícalo y libéralo instantáneamente." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
