<ui:FluentWindow x:Class="OmniWin.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:OmniWin.UI.Views"
        Title="OmniWin — Windows Control Plane, Optimizer &amp; MCP Agent"
        Height="780" Width="1200"
        MinHeight="660" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/omniwin.ico"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource BgDark}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <ui:FluentWindow.Resources>
        <!-- Horizontal Hub Sub-Navigation Pill Button Style -->
        <Style x:Key="SubNavPill" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource CardDarkHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubNavPillActive" TargetType="{x:Type Button}" BasedOn="{StaticResource SubNavPill}">
            <Setter Property="Background" Value="{DynamicResource ButtonPrimaryBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonPrimaryBg}" />
            <Setter Property="Foreground" Value="{DynamicResource ButtonPrimaryFg}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="{DynamicResource BgDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- WinUI 3 Modern TitleBar with Native Window Controls -->
        <ui:TitleBar Grid.Row="0"
                     Title="OmniWin — Windows Control Plane, Optimizer &amp; MCP Agent"
                     ShowMaximize="True"
                     ShowMinimize="True"
                     ShowClose="True"
                     Padding="12,0" />

        <!-- Two-Column Master Layout: Left Sidebar + Main Stage -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="234" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ========================================================= -->
            <!-- 1. LEFT SIDEBAR NAVIGATION                               -->
            <!-- ========================================================= -->
            <Border Grid.Column="0" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- App Brand Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Navigation Categories -->
                        <RowDefinition Height="*" />
                        <!-- Active Tasks Drawer -->
                        <RowDefinition Height="Auto" />
                        <!-- Sidebar Footer Status -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Brand Header -->
                    <Border Grid.Row="0" Padding="16,14,16,12" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0">
                                <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="OmniWin" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                    <Border Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="4" Margin="6,1,0,1" Padding="5,0">
                                        <TextBlock Text="PRO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Windows Control Plane" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Margin="0,1,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Navigation Items List (6 Main Hubs) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8,10,8,10">
                        <StackPanel>
                            <TextBlock Text="CENTROS DE CONTROL" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextSubtle}" Margin="10,6,0,8" />
                            <Button x:Name="NavHub0" Tag="0" Content="📊  Visión General" Style="{DynamicResource NavButtonActive}" Click="NavHub_Click" Margin="0,0,0,3" />
                            <Button x:Name="NavHub1" Tag="1" Content="⚡  Rendimiento &amp; Gaming" Style="{DynamicResource NavButton}" Click="NavHub_Click" Margin="0,0,0,3" />
                            <Button x:Name="NavHub2" Tag="2" Content="💾  Almacenamiento" Style="{DynamicResource NavButton}" Click="NavHub_Click" Margin="0,0,0,3" />
                            <Button x:Name="NavHub3" Tag="3" Content="🌐  Red &amp; Conectividad" Style="{DynamicResource NavButton}" Click="NavHub_Click" Margin="0,0,0,3" />
                            <Button x:Name="NavHub4" Tag="4" Content="🛡️  Seguridad &amp; Privacidad" Style="{DynamicResource NavButton}" Click="NavHub_Click" Margin="0,0,0,3" />
                            <Button x:Name="NavHub5" Tag="5" Content="⚙️  Sistema &amp; Herramientas" Style="{DynamicResource NavButton}" Click="NavHub_Click" Margin="0,0,0,3" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Active Tasks Drawer (Shown when background operations like Zero-Copy Deduplication run) -->
                    <Border x:Name="PnlActiveTasksDrawer" Grid.Row="2" Visibility="Collapsed" Padding="10,8" Margin="8,4,8,8" Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <Grid Margin="2,0,2,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="⚡ TAREAS ACTIVAS" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" HorizontalAlignment="Right" Width="7" Height="7" CornerRadius="3.5" Background="{DynamicResource Emerald}" />
                            </Grid>
                            <ItemsControl x:Name="IcActiveTasks">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,2,0,2" Padding="8,6" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Cursor="Hand" MouseDown="ActiveTaskItem_MouseDown" ToolTip="Haz clic para ver el progreso de esta tarea">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="Ver ➔" FontSize="10" Foreground="{DynamicResource TextPrimary}" Margin="4,0,0,0" />
                                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Sidebar Footer -->
                    <Border Grid.Row="3" Padding="12,10" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <!-- Admin Status Chip -->
                            <Border x:Name="BadgeAdmin" Background="#062E21" BorderBrush="#0A4835" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,8" Cursor="Hand" MouseDown="BadgeAdmin_MouseDown" ToolTip="Haz clic para reiniciar con privilegios de Administrador">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtAdminIcon" Text="🛡️" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock x:Name="TxtAdminStatus" Grid.Column="1" Text="Administrador" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Emerald}" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Width="6" Height="6" CornerRadius="3" Background="{DynamicResource Emerald}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Guided Tuning Wizard & Welcome Tour Action Buttons -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnOpenWizard" Content="🧭 Asistente" Click="BtnOpenWizard_Click" Style="{StaticResource SecondaryButton}" Padding="4,6" FontSize="10.5" Margin="0,0,3,0" ToolTip="Asistente de Optimización Guiada (7 pasos)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                <Button x:Name="BtnOpenTour" Grid.Column="1" Content="💡 Tour" Click="BtnOpenTour_Click" Style="{StaticResource SecondaryButton}" Padding="4,6" FontSize="10.5" Margin="3,0,0,0" ToolTip="Tour de Bienvenida y Atajos Globales" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ========================================================= -->
            <!-- 2. MAIN STAGE (TOP BAR + TABS CONTENT + FOOTER)           -->
            <!-- ========================================================= -->
            <Grid Grid.Column="1" Margin="18,14,18,14">
                <Grid.RowDefinitions>
                    <!-- Top Breadcrumb & Actions Bar -->
                    <RowDefinition Height="Auto" />
                    <!-- Hub Sub-Navigation Horizontal Strip -->
                    <RowDefinition Height="Auto" />
                    <!-- Tab Pages Content (Borderless) -->
                    <RowDefinition Height="*" />
                    <!-- Status Bar Footer -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Breadcrumb & Action Bar (WinUI 3 Header Pattern) -->
                <Border Grid.Row="0" Margin="0,0,0,12" Padding="0,0,0,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Dynamic Section Title & WinUI 3 Breadcrumbs -->
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="OmniWin" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Text=" ❯ " FontSize="9" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="4,0" />
                                <TextBlock Text="Centros de Control" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Text=" ❯ " FontSize="9" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="4,0" />
                                <TextBlock x:Name="TxtBreadcrumbCurrent" Text="Dashboard" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                            <TextBlock x:Name="TxtActiveSectionTitle" Text="📊 Dashboard del Sistema" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock x:Name="TxtActiveSectionDesc" Text="Resumen de telemetría de hardware, almacenamiento y procesos activos en vivo." FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- WinUI 3 CommandBar Action Controls -->
                        <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <!-- Theme Toggle Button (Light/Dark Monochrome) -->
                            <Button x:Name="BtnToggleTheme" Content="☀️ Modo Claro" Click="BtnToggleTheme_Click" Style="{DynamicResource SecondaryButton}" Padding="8,4" FontSize="10.5" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Alternar entre Modo Oscuro (Obsidian) y Modo Claro (Ceramic)" />

                            <!-- MCP Status Chip -->
                            <Border Background="#062E21" BorderBrush="#0A4835" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Emerald}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="MCP Activo (49 tools)" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Emerald}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Language Switcher Button -->
                            <Button x:Name="BtnLang" Content="🌐 ES" Click="BtnLang_Click" Style="{DynamicResource SecondaryButton}" Padding="7,4" FontSize="10.5" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Alternar idioma (ES / EN)" />

                            <!-- OmniCompanion Mobile Web Button -->
                            <Button x:Name="BtnTopCompanion" Content="📱 Móvil QR" Click="BtnTopCompanion_Click" Style="{DynamicResource SecondaryButton}" Padding="8,4" FontSize="10.5" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Abrir panel web OmniCompanion con QR" />

                            <!-- Caffeine / Awake Button -->
                            <Button x:Name="BtnTopAwake" Content="☕ Awake: Off" Click="BtnTopAwake_Click" Style="{DynamicResource SecondaryButton}" Padding="8,4" FontSize="10.5" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Evita que la pantalla entre en suspensión" />

                            <!-- Floating Traffic Widget Button -->
                            <Button x:Name="BtnTopWidget" Content="📌 Widget" Click="BtnTopWidget_Click" Style="{DynamicResource SecondaryButton}" Padding="8,4" FontSize="10.5" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Widget flotante en escritorio (Ctrl+Shift+W)" />

                            <!-- Gaming HUD Overlay Button -->
                            <Button x:Name="BtnTopOverlay" Content="🎮 Overlay" Click="BtnTopOverlay_Click" Style="{DynamicResource SecondaryButton}" Padding="8,4" FontSize="10.5" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Alternar HUD en juego (Ctrl+Shift+O)" />

                            <!-- Quick RAM Purge Button -->
                            <Button x:Name="BtnQuickPurge" Content="⚡ Liberar RAM" Click="BtnQuickPurge_Click" Style="{DynamicResource PrimaryButton}" Padding="10,5" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Purgar Standby List (Ctrl+Shift+P)" />

                            <!-- Optimization Report Button -->
                            <Button x:Name="BtnTopReport" Content="📄 Reporte" Click="BtnTopReport_Click" Style="{DynamicResource SecondaryButton}" Padding="8,4" FontSize="10.5" VerticalAlignment="Center" ToolTip="Generar informe interactivo en HTML" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- Hub Sub-Navigation Horizontal Pill Strip -->
                <Border Grid.Row="1" x:Name="HubSubNavStrip" Margin="0,0,0,10" Padding="4" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="HubSubNavPanel" Orientation="Horizontal" />
                    </ScrollViewer>
                </Border>

                <!-- Tab Pages Content (Borderless TabControl, TabItems act as Pages) -->
                <TabControl Grid.Row="2" x:Name="MainTabs" SelectedIndex="0" Background="Transparent" BorderThickness="0" Padding="0" SelectionChanged="MainTabs_SelectionChanged">
                    <TabControl.Template>
                        <ControlTemplate TargetType="{x:Type TabControl}">
                            <ContentPresenter ContentSource="SelectedContent" Margin="{TemplateBinding Padding}" />
                        </ControlTemplate>
                    </TabControl.Template>
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Style>
                    </TabControl.ItemContainerStyle>
            
            <!-- TAB 1: DASHBOARD -->
            <TabItem Header="📊 Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Top Metric Cards (WinUI 3 Elevated Cards) -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- RAM Card -->
                            <Border Grid.Column="0" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,8,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <!-- Header Row -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="🧠" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="MEMORIA RAM" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock Text="DDR5 High-Speed" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                        </StackPanel>
                                        <Border Grid.Column="2" x:Name="BrdRamUsageBadge" Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtRamPercentBadge" Text="--% en uso" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                        </Border>
                                    </Grid>

                                    <!-- Value Metric -->
                                    <TextBlock Grid.Row="1" x:Name="TxtRamSummary" Text="-- / -- GB" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6" />

                                    <!-- WinUI 3 Fluent Progress Track -->
                                    <ProgressBar Grid.Row="2" x:Name="PbRam" Value="0" Maximum="100" Height="6" Margin="0,4,0,8" Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource CardBorderSubtle}" />

                                    <!-- Footer Stats -->
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TxtRamPercent" Text="Carga: 0%" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Grid.Column="1" Text="Standby Purge: Listo" FontSize="10.5" Foreground="{DynamicResource TextMuted}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- CPU Card -->
                            <Border Grid.Column="1" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="4,0,4,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <!-- Header Row -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="⚡" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="PROCESADOR (CPU)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock Text="P-Cores + E-Cores" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtCpuLoadBadge" Text="--% Activo" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Emerald}" />
                                        </Border>
                                    </Grid>

                                    <!-- Value Metric (Processor Name) -->
                                    <TextBlock Grid.Row="1" x:Name="TxtCpuName" Text="Cargando..." FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,6" />

                                    <!-- WinUI 3 Fluent Progress Track -->
                                    <ProgressBar Grid.Row="2" x:Name="PbCpu" Value="0" Maximum="100" Height="6" Margin="0,4,0,8" Foreground="{DynamicResource Emerald}" Background="{DynamicResource CardBorderSubtle}" />

                                    <!-- Footer Stats -->
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TxtCpuLoad" Text="Carga: 0%" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Text="EcoQoS / Affinity Activo" FontSize="10.5" Foreground="{DynamicResource TextMuted}" Grid.Column="1" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- GPU Card -->
                            <Border Grid.Column="2" Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="8,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <!-- Header Row -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="🎮" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="GRÁFICA (GPU)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock Text="GDDR6X Dedicada" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{DynamicResource CardDarkHover}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtGpuTempBadge" Text="--°C" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Amber}" />
                                        </Border>
                                    </Grid>

                                    <!-- Value Metric (GPU Name) -->
                                    <TextBlock Grid.Row="1" x:Name="TxtGpuName" Text="Cargando..." FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,6" />

                                    <!-- WinUI 3 Fluent Progress Track -->
                                    <ProgressBar Grid.Row="2" x:Name="PbGpu" Value="0" Maximum="100" Height="6" Margin="0,4,0,8" Foreground="{DynamicResource Amber}" Background="{DynamicResource CardBorderSubtle}" />

                                    <!-- Footer Stats -->
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TxtGpuLoad" Text="Carga: 0% | Temp: --°C" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock x:Name="TxtGpuPcieQuick" Text="PCIe: Detectando... • VBIOS: --" FontSize="10.5" Foreground="{DynamicResource TextPrimary}" Grid.Column="1" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

