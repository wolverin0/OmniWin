            </TabItem>

            <!-- TAB 3: PROCESOS & FORENSE (SYSTEM INFORMER) -->
            <TabItem Header="🔍 Procesos">
                <views:ProcessExplorerControl Margin="0,12,0,0" />
            </TabItem>

            <!-- TAB 3: OPTIMIZADOR DE RAM -->
            <TabItem Header="⚡ RAM">
                <Border Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,12,0,0">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Optimizador de Memoria del Sistema" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="Libera instantáneamente la lista de reserva (Standby List) y purga conjuntos de trabajo de procesos inactivos utilizando la API nativa NT." 
                                   TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,24" />

                        <Border Background="{DynamicResource CardDarkHover}" CornerRadius="8" Padding="20" Margin="0,0,0,24" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Estado Actual de la Memoria" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock x:Name="TxtRamDetailLoad" Text="--% en uso" HorizontalAlignment="Right" Foreground="{DynamicResource Accent}" FontWeight="Bold" />
                                </Grid>
                                <ProgressBar x:Name="PbRamDetail" Value="50" Maximum="100" Height="10" Margin="0,0,0,12" Foreground="{DynamicResource Accent}" />
                                <Grid>
                                    <TextBlock x:Name="TxtRamDetailUsed" Text="Usada: -- GB" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="TxtRamDetailAvailable" Text="Disponible: -- GB" HorizontalAlignment="Right" FontSize="12" Foreground="#10B981" FontWeight="SemiBold" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnPurgeAllRam" Content="🚀 Optimizar y Purgar Memoria RAM" Click="BtnPurgeAllRam_Click" 
                                Height="46" FontSize="15" Margin="0,0,0,16" />

                        <TextBlock x:Name="TxtRamStatusLog" Text="" HorizontalAlignment="Center" Foreground="#34D399" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- TAB 3: LIMPIEZA DE DISCO -->
            <TabItem Header="🧹 Disco">
                <Border Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Limpiador Seguro de Basura y Caché" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="Selecciona las categorías para recuperar gigabytes de archivos inservibles." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Button Content="🔍 Analizar Espacio" Click="BtnScanBloat_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                <Button Content="🧹 Limpiar Seleccionados" Click="BtnCleanBloat_Click" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl Grid.Row="1" x:Name="IcBloatCategories">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardDarkHover}" CornerRadius="6" Padding="14" Margin="0,0,0,8" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}" />
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding SizeText}" FontWeight="Bold" FontSize="12.5" TextAlignment="Right" Foreground="{DynamicResource Accent}" />
                                                <TextBlock Text="{Binding FileCountText}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Grid.Row="2" Background="{DynamicResource CardDarkHover}" CornerRadius="6" Padding="12" Margin="0,12,0,0" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                            <TextBlock x:Name="TxtDiskStatusLog" Text="Listo para analizar el almacenamiento del equipo." FontSize="12" Foreground="{DynamicResource TextPrimary}" />
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 4: TWEAKS Y OPTIMIZACIONES / DEBLOAT -->
            <TabItem Header="🛠️ Tweaks &amp; Debloat">
                <views:TweaksDebloatControl Margin="0,12,0,0" />
            </TabItem>

            <!-- TAB 6: SOFTWARE, CONTROLADORES, DESINSTALADOR & BIOS -->
            <TabItem Header="📦 Software &amp; Drivers">
                <views:SoftwareDriversControl Margin="0,12,0,0" />
            </TabItem>

            <!-- TAB 6: SISTEMA Y ENERGÍA -->
            <TabItem Header="⚙️ Sistema">
                <Border Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,12,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Mantenimiento Profundo de Windows &amp; Latencia" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                            <TextBlock Text="Limpieza del almacén de componentes WinSxS con DISM, comprobación de integridad con SFC y optimización de energía." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,16" />

                            <!-- DISM & SFC Card -->
                            <Border Background="{DynamicResource CardDarkHover}" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="INTEGRIDAD Y ALMACÉN DE COMPONENTES WINSXS" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                                    <TextBlock Text="Recupera entre 5 y 20 GB de espacio eliminando copias de seguridad de actualizaciones viejas de Windows o repara archivos corruptos." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="🧹 Limpiar WinSxS (DISM /ResetBase)" Click="BtnDismClean_Click" Margin="0,0,10,0" Padding="12,6" FontSize="12" />
                                        <Button Content="🛡️ Comprobar Sistema (SFC /scannow)" Click="BtnSfcScan_Click" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="12" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Power & Latency Card -->
                            <Border Background="{DynamicResource CardDarkHover}" CornerRadius="8" Padding="16" Margin="0,0,0,16" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="PLANES DE ENERGÍA Y TEMPORIZADOR DE ALTA PRECISIÓN" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                                    <TextBlock Text="Desbloquea el plan oculto 'Máximo Rendimiento' de Windows para evitar caídas de frecuencia de CPU y activa el temporizador a 0.5ms para menor input lag." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="⚡ Desbloquear Plan Máximo Rendimiento" Click="BtnUnlockUltimatePower_Click" Margin="0,0,10,0" Padding="12,6" FontSize="12" />
                                        <Button Content="⏱️ Forzar Timer 0.5ms (Baja Latencia)" Click="BtnSetHighPrecisionTimer_Click" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="12" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Log Box -->
                            <Border Background="{DynamicResource BgInput}" CornerRadius="6" Padding="14" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                                <TextBlock x:Name="TxtSystemActionsLog" Text="Listo para ejecutar tareas de mantenimiento del sistema." FontFamily="Consolas" FontSize="12" Foreground="#34D399" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- TAB: REPARACIÓN INTEGRAL (REPAIRKIT) -->
            <TabItem Header="🛠️ Reparación">
                <views:RepairConsoleControl />
            </TabItem>

            <!-- TAB 7: RED Y SEGURIDAD -->
            <TabItem Header="🌐 Red">
                <Border Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Diagnóstico de Red &amp; Reparación de Pila de Conexión" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="Latencia DNS, sockets activos y reparación en 1 clic de la caché DNS y el catálogo Winsock." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="🔄 Diagnosticar" Click="BtnDiagnoseNetwork_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="10,5" FontSize="11" />
                                <Button Content="🛠️ Reparar Pila de Red (Flush DNS)" Click="BtnHealNetwork_Click" Padding="10,5" FontSize="11" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{DynamicResource CardDarkHover}" CornerRadius="6" Padding="14" Margin="0,0,8,0" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="INTERNET" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock x:Name="TxtNetStatus" Text="Conectado ✔" FontSize="16" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="{DynamicResource CardDarkHover}" CornerRadius="6" Padding="14" Margin="4,0,4,0" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="RESOLUCIÓN DNS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock x:Name="TxtDnsSpeed" Text="-- ms" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="{DynamicResource CardDarkHover}" CornerRadius="6" Padding="14" Margin="8,0,0,0" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="SOCKETS TCP ACTIVOS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock x:Name="TxtTcpSockets" Text="--" FontSize="16" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Text="AUDITORÍA DE SEGURIDAD Y PROTECCIÓN" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                                <Border Background="{DynamicResource CardDarkHover}" CornerRadius="6" Padding="14" Margin="0,0,0,16" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtAntivirusInfo" Text="Antivirus: Detectando..." FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                                        <TextBlock x:Name="TxtUacInfo" Text="UAC: Habilitado ✔" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                                        <TextBlock x:Name="TxtBsodInfo" Text="Eventos BSOD (Kernel-Power ID 41): 0 eventos en 48h ✔" FontSize="12" Foreground="#34D399" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Border Grid.Row="2" Background="{DynamicResource CardDarkHover}" CornerRadius="6" Padding="12" Margin="0,12,0,0" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                            <TextBlock x:Name="TxtNetLog" Text="Haz clic en 'Diagnosticar' o 'Reparar Pila de Red' para comenzar." FontSize="12" Foreground="{DynamicResource TextPrimary}" />
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 8: DESBLOQUEADOR DE ARCHIVOS -->
