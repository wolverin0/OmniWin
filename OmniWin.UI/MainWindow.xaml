<Window x:Class="OmniWin.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OmniWin.UI.Views"
        Title="OmniWin — Windows Control Plane, Optimizer &amp; MCP Agent"
        Height="780" Width="1200"
        MinHeight="660" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/omniwin.ico"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Grid>
        <!-- Two-Column Master Layout: Left Sidebar + Main Stage -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="234" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ========================================================= -->
            <!-- 1. LEFT SIDEBAR NAVIGATION                               -->
            <!-- ========================================================= -->
            <Border Grid.Column="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- App Brand Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Navigation Categories -->
                        <RowDefinition Height="*" />
                        <!-- Sidebar Footer Status -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Brand Header -->
                    <Border Grid.Row="0" Padding="16,14,16,12" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" Background="#0C243C" BorderBrush="#16395F" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0">
                                <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Accent}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="OmniWin" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                    <Border Background="#101B2E" BorderBrush="#1A2D4C" BorderThickness="1" CornerRadius="4" Margin="6,1,0,1" Padding="5,0">
                                        <TextBlock Text="PRO" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Windows Control Plane" FontSize="10.5" Foreground="{StaticResource TextMuted}" Margin="0,1,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Navigation Items List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="6,8,6,8">
                        <StackPanel>
                            <!-- CATEGORY 1: MONITOREO & HARDWARE -->
                            <TextBlock Text="MONITOREO &amp; HARDWARE" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSubtle}" Margin="12,6,0,4" />
                            <Button x:Name="NavBtn0" Tag="0" Content="📊  Dashboard" Style="{StaticResource NavButtonActive}" Click="NavBtn_Click" />
                            <Button x:Name="NavBtn1" Tag="1" Content="📈  Telemetría &amp; Live" Style="{StaticResource NavButton}" Click="NavBtn_Click" />
                            <Button x:Name="NavBtn18" Tag="18" Content="📱  OmniCompanion Móvil" Style="{StaticResource NavButton}" Click="NavBtn_Click" />
                            <Button x:Name="NavBtn2" Tag="2" Content="🔍  Forense Procesos" Style="{StaticResource NavButton}" Click="NavBtn_Click" />

                            <!-- CATEGORY 2: RENDIMIENTO & OPTIMIZACIÓN -->
                            <TextBlock Text="RENDIMIENTO &amp; LATENCIA" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSubtle}" Margin="12,14,0,4" />
                            <Button x:Name="NavBtn3" Tag="3" Content="⚡  Memoria RAM" Style="{StaticResource NavButton}" Click="NavBtn_Click" />
                            <Button x:Name="NavBtn19" Tag="19" Content="🎮  Game &amp; App Profiler" Style="{StaticResource NavButton}" Click="NavBtn_Click" />
                            <Button x:Name="NavBtn15" Tag="15" Content="🔋  Energía &amp; CPU" Style="{StaticResource NavButton}" Click="NavBtn_Click" />
                            <Button x:Name="NavBtn4" Tag="4" Content="🧹  Limpieza de Disco" Style="{StaticResource NavButton}" Click="NavBtn_Click" />
                            <Button x:Name="NavBtn16" Tag="16" Content="💾  Espacio en Disco" Style="{StaticResource NavButton}" Click="NavBtn_Click" />
                            <Button x:Name="NavBtn23" Tag="23" Content="🗂️  Deduplicador Zero-Copy" Style="{StaticResource NavButton}" Click="NavBtn_Click" />
                            <Button x:Name="NavBtn26" Tag="26" Content="🚀  Migrador Apps &amp; Juegos" Style="{StaticResource NavButton}" Click="NavBtn_Click" />
                            <Button x:Name="NavBtn22" Tag="22" Content="♻️  Recuperación Archivos" Style="{StaticResource NavButton}" Click="NavBtn_Click" />
                            <Button x:Name="NavBtn5" Tag="5" Content="🛠️  Tweaks &amp; Debloat" Style="{StaticResource NavButton}" Click="NavBtn_Click" />
                            <Button x:Name="NavBtn7" Tag="7" Content="⚙️  Mantenimiento" Style="{StaticResource NavButton}" Click="NavBtn_Click" />
                            <Button x:Name="NavBtn8" Tag="8" Content="🩹  Consola Reparación" Style="{StaticResource NavButton}" Click="NavBtn_Click" />

                            <!-- CATEGORY 3: CONECTIVIDAD & SISTEMA -->
                            <TextBlock Text="CONECTIVIDAD &amp; SISTEMA" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSubtle}" Margin="12,14,0,4" />
                            <Button x:Name="NavBtn9" Tag="9" Content="🌐  Red &amp; Sockets" Style="{StaticResource NavButton}" Click="NavBtn_Click" />
                            <Button x:Name="NavBtn20" Tag="20" Content="🛡️  Cortafuegos Visual" Style="{StaticResource NavButton}" Click="NavBtn_Click" />
                            <Button x:Name="NavBtn21" Tag="21" Content="🔒  DNS Seguro &amp; HOSTS" Style="{StaticResource NavButton}" Click="NavBtn_Click" />
                            <Button x:Name="NavBtn27" Tag="27" Content="🌐  Red QoS, Puertos &amp; Idle" Style="{StaticResource NavButton}" Click="NavBtn_Click" />
                            <Button x:Name="NavBtn10" Tag="10" Content="🔒  Desbloqueo Archivos" Style="{StaticResource NavButton}" Click="NavBtn_Click" />
                            <Button x:Name="NavBtn24" Tag="24" Content="🔌  Expulsor USB &amp; Flash" Style="{StaticResource NavButton}" Click="NavBtn_Click" />
                            <Button x:Name="NavBtn11" Tag="11" Content="🚀  Inicio de Windows" Style="{StaticResource NavButton}" Click="NavBtn_Click" />
                            <Button x:Name="NavBtn13" Tag="13" Content="🎧  Mezclador de Audio" Style="{StaticResource NavButton}" Click="NavBtn_Click" />

                            <!-- CATEGORY 4: SEGURIDAD & AGENTE IA -->
                            <TextBlock Text="SEGURIDAD &amp; AGENTE IA" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextSubtle}" Margin="12,14,0,4" />
                            <Button x:Name="NavBtn25" Tag="25" Content="🛡️  Privacidad &amp; Anti-Espía" Style="{StaticResource NavButton}" Click="NavBtn_Click" />
                            <Button x:Name="NavBtn14" Tag="14" Content="🛡️  Reglas Defender ASR" Style="{StaticResource NavButton}" Click="NavBtn_Click" />
                            <Button x:Name="NavBtn17" Tag="17" Content="✈️  Caja Negra &amp; BSOD" Style="{StaticResource NavButton}" Click="NavBtn_Click" />
                            <Button x:Name="NavBtn6" Tag="6" Content="📦  Software &amp; Drivers" Style="{StaticResource NavButton}" Click="NavBtn_Click" />
                            <Button x:Name="NavBtn12" Tag="12" Content="🤖  Servidor IA / MCP" Style="{StaticResource NavButton}" Click="NavBtn_Click" />
                            <Button x:Name="NavBtn28" Tag="28" Content="📸  Fondos 4K Spotlight" Style="{StaticResource NavButton}" Click="NavBtn_Click" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sidebar Footer -->
                    <Border Grid.Row="2" Padding="12,10" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <!-- Admin Status Chip -->
                            <Border x:Name="BadgeAdmin" Background="#062E21" BorderBrush="#0A4835" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,6" Cursor="Hand" MouseDown="BadgeAdmin_MouseDown" ToolTip="Haz clic para reiniciar con privilegios de Administrador">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtAdminIcon" Text="🛡️" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock x:Name="TxtAdminStatus" Grid.Column="1" Text="Administrador" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Emerald}" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Width="6" Height="6" CornerRadius="3" Background="{StaticResource Emerald}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Onboarding Button -->
                            <Button x:Name="BtnOpenWizard" Content="🧭 Guía / Onboarding" Click="BtnOpenWizard_Click" Style="{StaticResource SecondaryButton}" Padding="8,5" FontSize="11" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ========================================================= -->
            <!-- 2. MAIN STAGE (TOP BAR + TABS CONTENT + FOOTER)           -->
            <!-- ========================================================= -->
            <Grid Grid.Column="1" Margin="18,14,18,14">
                <Grid.RowDefinitions>
                    <!-- Top Breadcrumb & Actions Bar -->
                    <RowDefinition Height="Auto" />
                    <!-- Tab Pages Content (Borderless) -->
                    <RowDefinition Height="*" />
                    <!-- Status Bar Footer -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Breadcrumb & Action Bar -->
                <Border Grid.Row="0" Margin="0,0,0,14" Padding="0,0,0,12" BorderThickness="0,0,0,1" BorderBrush="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Dynamic Section Title -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtActiveSectionTitle" Text="📊 Dashboard del Sistema" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock x:Name="TxtActiveSectionDesc" Text="Resumen de telemetría de hardware, almacenamiento y procesos activos en vivo." FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Action Controls -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- MCP Status Chip -->
                            <Border Background="#062E21" BorderBrush="#0A4835" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource Emerald}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="MCP Activo (49 tools)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Emerald}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- Language Switcher Button -->
                            <Button x:Name="BtnLang" Content="🌐 ES" Click="BtnLang_Click" Style="{StaticResource SecondaryButton}" Padding="8,6" FontSize="11" Margin="0,0,8,0" ToolTip="Alternar idioma de la interfaz (Español / English)" />

                            <!-- OmniCompanion Mobile Web Button -->
                            <Button x:Name="BtnTopCompanion" Content="📱 Móvil QR" Click="BtnTopCompanion_Click" Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="11.5" Margin="0,0,8,0" ToolTip="Abrir panel web OmniCompanion con código QR para móvil/tablet" />

                            <!-- Caffeine / Awake Button -->
                            <Button x:Name="BtnTopAwake" Content="☕ Cafeína: Off" Click="BtnTopAwake_Click" Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="11.5" Margin="0,0,8,0" ToolTip="Evita que la pantalla o el sistema entren en suspensión (PowerToys Awake)" />

                            <!-- Floating Traffic Widget Button -->
                            <Button x:Name="BtnTopWidget" Content="📌 Widget Flotante" Click="BtnTopWidget_Click" Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="11.5" Margin="0,0,8,0" ToolTip="Abrir widget flotante de red y temperaturas en escritorio (Ctrl+Shift+W)" />

                            <!-- Gaming HUD Overlay Button -->
                            <Button x:Name="BtnTopOverlay" Content="🎮 Overlay HUD" Click="BtnTopOverlay_Click" Style="{StaticResource SecondaryButton}" Padding="12,6" FontSize="11.5" Margin="0,0,8,0" ToolTip="Alternar HUD flotante en juego (Ctrl+Shift+O)" />

                            <!-- Quick RAM Purge Button -->
                            <Button x:Name="BtnQuickPurge" Content="⚡ Liberar RAM" Click="BtnQuickPurge_Click" Padding="12,6" FontSize="11.5" Margin="0,0,8,0" ToolTip="Purgar Standby List y memoria de procesos (Ctrl+Shift+P)" />

                            <!-- Optimization Report Button -->
                            <Button x:Name="BtnTopReport" Content="📄 Reporte" Click="BtnTopReport_Click" Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="11.5" ToolTip="Generar informe interactivo de optimizaciones en HTML" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tab Pages Content (Borderless TabControl, TabItems act as Pages) -->
                <TabControl Grid.Row="1" x:Name="MainTabs" Background="Transparent" BorderThickness="0" Padding="0" SelectionChanged="MainTabs_SelectionChanged">
                    <TabControl.Template>
                        <ControlTemplate TargetType="{x:Type TabControl}">
                            <ContentPresenter ContentSource="SelectedContent" Margin="{TemplateBinding Padding}" />
                        </ControlTemplate>
                    </TabControl.Template>
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Style>
                    </TabControl.ItemContainerStyle>
            
            <!-- TAB 1: DASHBOARD -->
            <TabItem Header="📊 Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Top Metric Cards -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- RAM Card -->
                            <Border Grid.Column="0" Background="{StaticResource CardDark}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="MEMORIA RAM" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock x:Name="TxtRamSummary" Text="-- / -- GB" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,6,0,8" />
                                    <ProgressBar x:Name="PbRam" Value="0" Maximum="100" Height="6" Margin="0,0,0,6" Foreground="{StaticResource Accent}" />
                                    <TextBlock x:Name="TxtRamPercent" Text="Carga: 0%" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                            </Border>

                            <!-- CPU Card -->
                            <Border Grid.Column="1" Background="{StaticResource CardDark}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="4,0,4,0">
                                <StackPanel>
                                    <TextBlock Text="PROCESADOR (CPU)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock x:Name="TxtCpuName" Text="Cargando..." FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimary}" Margin="0,6,0,8" />
                                    <ProgressBar x:Name="PbCpu" Value="0" Maximum="100" Height="6" Margin="0,0,0,6" Foreground="#10B981" />
                                    <TextBlock x:Name="TxtCpuLoad" Text="Carga: 0%" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                            </Border>

                            <!-- GPU Card -->
                            <Border Grid.Column="2" Background="{StaticResource CardDark}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="GRÁFICA (GPU)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock x:Name="TxtGpuName" Text="Cargando..." FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimary}" Margin="0,6,0,8" />
                                    <ProgressBar x:Name="PbGpu" Value="0" Maximum="100" Height="6" Margin="0,0,0,6" Foreground="#F59E0B" />
                                    <TextBlock x:Name="TxtGpuLoad" Text="Carga: 0% | Temp: --°C" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock x:Name="TxtGpuPcieQuick" Text="PCIe: Detectando... • VBIOS: --" FontSize="10.5" Foreground="{StaticResource Accent}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Storage Drives Section -->
                        <!-- Drives Quickview -->
                        <Border Grid.Row="1" Background="{StaticResource CardDark}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="UNIDADES DE ALMACENAMIENTO" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12" />
                                <ItemsControl x:Name="IcDrives">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="150" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding NameAndLabel}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                                <ProgressBar Grid.Column="1" Value="{Binding UsagePercent}" Maximum="100" Height="8" VerticalAlignment="Center" Margin="12,0" Foreground="#0284C7" />
                                                <TextBlock Grid.Column="2" Text="{Binding SpaceText}" VerticalAlignment="Center" TextAlignment="Right" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Process List Quickview -->
                        <Border Grid.Row="2" Background="{StaticResource CardDark}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="PROCESOS ACTIVOS DE MAYOR CONSUMO" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                    <Button Content="Actualizar" Click="BtnRefresh_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Padding="10,4" FontSize="11" />
                                </Grid>
                                <DataGrid Grid.Row="1" x:Name="DgProcesses" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220"
                                          Background="Transparent" BorderThickness="0" GridLinesVisibility="None" HeadersVisibility="Column"
                                          Foreground="{StaticResource TextPrimary}" RowBackground="Transparent">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" />
                                        <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="160" />
                                        <DataGridTextColumn Header="RAM (MB)" Binding="{Binding MemoryMB, StringFormat={}{0:N1} MB}" Width="100" />
                                        <DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: TELEMETRÍA & PROMETHEUS -->
            <TabItem Header="📈 Telemetría">
                <views:HardwareTelemetryControl Margin="0,12,0,0" />
            </TabItem>

            <!-- TAB 3: PROCESOS & FORENSE (SYSTEM INFORMER) -->
            <TabItem Header="🔍 Procesos">
                <views:ProcessExplorerControl Margin="0,12,0,0" />
            </TabItem>

            <!-- TAB 3: OPTIMIZADOR DE RAM -->
            <TabItem Header="⚡ RAM">
                <Border Background="{StaticResource CardDark}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,12,0,0">
                    <StackPanel MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Optimizador de Memoria del Sistema" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="Libera instantáneamente la lista de reserva (Standby List) y purga conjuntos de trabajo de procesos inactivos utilizando la API nativa NT." 
                                   TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,24" />

                        <Border Background="#090D16" CornerRadius="8" Padding="20" Margin="0,0,0,24" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Estado Actual de la Memoria" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock x:Name="TxtRamDetailLoad" Text="--% en uso" HorizontalAlignment="Right" Foreground="{StaticResource Accent}" FontWeight="Bold" />
                                </Grid>
                                <ProgressBar x:Name="PbRamDetail" Value="50" Maximum="100" Height="10" Margin="0,0,0,12" Foreground="{StaticResource Accent}" />
                                <Grid>
                                    <TextBlock x:Name="TxtRamDetailUsed" Text="Usada: -- GB" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock x:Name="TxtRamDetailAvailable" Text="Disponible: -- GB" HorizontalAlignment="Right" FontSize="12" Foreground="#10B981" FontWeight="SemiBold" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnPurgeAllRam" Content="🚀 Optimizar y Purgar Memoria RAM" Click="BtnPurgeAllRam_Click" 
                                Height="46" FontSize="15" Margin="0,0,0,16" />

                        <TextBlock x:Name="TxtRamStatusLog" Text="" HorizontalAlignment="Center" Foreground="#34D399" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- TAB 3: LIMPIEZA DE DISCO -->
            <TabItem Header="🧹 Disco">
                <Border Background="{StaticResource CardDark}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Limpiador Seguro de Basura y Caché" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="Selecciona las categorías para recuperar gigabytes de archivos inservibles." FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Button Content="🔍 Analizar Espacio" Click="BtnScanBloat_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                <Button Content="🧹 Limpiar Seleccionados" Click="BtnCleanBloat_Click" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl Grid.Row="1" x:Name="IcBloatCategories">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#090D16" CornerRadius="6" Padding="14" Margin="0,0,0,8" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimary}" />
                                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding SizeText}" FontWeight="Bold" FontSize="12.5" TextAlignment="Right" Foreground="{StaticResource Accent}" />
                                                <TextBlock Text="{Binding FileCountText}" FontSize="11" Foreground="{StaticResource TextSecondary}" TextAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
