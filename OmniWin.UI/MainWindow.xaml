                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtUnlockFilePath" Text="C:\Windows\explorer.exe" Background="{DynamicResource CardDarkHover}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorder}" Padding="8,6" FontSize="13" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="🔍 Detectar Bloqueos" Click="BtnCheckFileLocks_Click" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="12,6" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="🔓 Desbloquear Archivo" Click="BtnUnlockFile_Click" Background="#EF4444" Margin="8,0,0,0" Padding="12,6" VerticalAlignment="Center" />
                        </Grid>

                        <DataGrid Grid.Row="2" x:Name="DgFileLocks" AutoGenerateColumns="False" IsReadOnly="True"
