                                  MouseDoubleClick="DgStartup_MouseDoubleClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="⏻ Activar / Desactivar" Click="BtnToggleStartupItem_Click" />
