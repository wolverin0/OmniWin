                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="2" Background="{DynamicResource CardDarkHover}" CornerRadius="6" Padding="12" Margin="0,12,0,0" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                            <TextBlock x:Name="TxtStartupLog" Text="Programas configurados para arrancar con el inicio de sesión." FontSize="12" Foreground="{DynamicResource TextPrimary}" />
                        </Border>
                    </Grid>
                </Border>
