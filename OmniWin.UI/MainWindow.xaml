                                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="80" />
                                <DataGridTextColumn Header="Proceso" Binding="{Binding ProcessName}" Width="160" />
                                <DataGridTextColumn Header="Tipo" Binding="{Binding ApplicationType}" Width="120" />
                                <DataGridTextColumn Header="Nombre / Título de App" Binding="{Binding AppName}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 9: INICIO Y SERVICIOS -->
