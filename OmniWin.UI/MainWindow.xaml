                <Border Background="{DynamicResource CardDark}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Administrador de Arranque y Servicios en Segundo Plano" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="Optimiza el arranque y desactiva servicios pesados de telemetría de Windows." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnToggleStartupItem" Content="⏻ Alternar Estado" Click="BtnToggleStartupItem_Click" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0" Padding="10,5" FontSize="11" ToolTip="Activa o desactiva la entrada de inicio seleccionada" />
                                <Button x:Name="BtnDeleteStartupItem" Content="🗑️ Quitar de Inicio" Click="BtnDeleteStartupItem_Click" Style="{DynamicResource SecondaryButton}" Foreground="#EF4444" Margin="0,0,8,0" Padding="10,5" FontSize="11" ToolTip="Elimina permanentemente la entrada de inicio seleccionada" />
                                <Button Content="Actualizar" Click="BtnRefreshStartup_Click" Style="{DynamicResource SecondaryButton}" Margin="0,0,8,0" Padding="10,5" FontSize="11" />
                                <Button Content="⚡ Desactivar Telemetría (Servicios)" Click="BtnOptimizeServices_Click" Style="{DynamicResource PrimaryButton}" Padding="10,5" FontSize="11" />
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="1" x:Name="DgStartup" AutoGenerateColumns="False" IsReadOnly="True"
