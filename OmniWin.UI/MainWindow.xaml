                                                    </StackPanel>
                                                    <ProgressBar Grid.Column="1" Value="{Binding UsagePercent}" Maximum="100" Height="6" VerticalAlignment="Center" Margin="14,0" Foreground="{DynamicResource TextPrimary}" Background="{DynamicResource CardBorderSubtle}" />
