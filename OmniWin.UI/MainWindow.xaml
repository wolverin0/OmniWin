                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Administrador de Discos ➔" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="10.5" Click="BtnOpenDiskManagement_Click" ToolTip="Abrir el Administrador de Discos de Windows (diskmgmt.msc)" />
                                </Grid>
                                <ItemsControl x:Name="IcDrives">
                                    <ItemsControl.ItemTemplate>
