                                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" />
                                        <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="160" />
                                        <DataGridTextColumn Header="RAM (MB)" Binding="{Binding MemoryMB, StringFormat={}{0:N1} MB}" Width="100" />
                                        <DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: TELEMETRÍA & PROMETHEUS -->
            <TabItem Header="📈 Telemetría">
