                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="PROCESOS ACTIVOS DE MAYOR CONSUMO" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                    <Button Content="Actualizar" Click="BtnRefresh_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Padding="10,4" FontSize="11" />
                                </Grid>
                                <DataGrid Grid.Row="1" x:Name="DgProcesses" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220"
